// The API around matching: starts out of range, group numbers and names,
// and caps made again by each call.
uses alloc, io

const regex = @import("regex")

fn show(io: Io, m: ?regex.Span) void {
    if (m) |sp| {
        io.print(sp.start, "-", sp.end, " len ", sp.len())
    } else {
        io.print("none")
    }
}

fn main(io: Io, a: Allocator) !void {
    // A start past the end, or before the start, finds nothing (and
    // asks nothing of the text before it).
    const line = try regex.compile(a, "(?m)^|\\b|$")
    defer a.free(line)
    show(io, line.find_at(a, "ab", 2))
    show(io, line.find_at(a, "ab", 3))
    show(io, line.find_at(a, "ab", -1))
    show(io, line.find_at(a, "", 0))
    show(io, line.find_at(a, "", 1))
    var caps: Buf(?regex.Span) = .empty
    defer a.free(caps)
    io.print(line.captures_at(a, "ab", 3, &caps), " ", @len(caps))
    io.print(line.captures_at(a, "ab", -5, &caps), " ", @len(caps))
    // Groups by number and by name.
    const date = try regex.compile(a, "(?P<y>\\d{4})-(?<m>\\d\\d)(?:-(\\d\\d))?")
    defer a.free(date)
    io.print(date.group_count(), " ", date.group_index("y") orelse -1, " ", date.group_index("m") orelse -1, " ", date.group_index("d") orelse -1)
    const s = "due 2026-11, or 2027-01-15"
    if (date.captures(a, s, &caps)) {
        io.print(@len(caps))
        for (caps) |c| {
            show(io, c)
        }
    }
    // From a later start, caps is made again, the third group now there.
    if (date.captures_at(a, s, 11, &caps)) {
        for (caps) |c| {
            show(io, c)
        }
    }
    // No match leaves caps empty.
    io.print(date.captures(a, "no date", &caps), " ", @len(caps))
    // A start inside a character still runs: offsets are bytes.
    const dot = try regex.compile(a, ".")
    defer a.free(dot)
    show(io, dot.find_at(a, "日x", 1))
    // Going through the matches, with and without groups; an Iter that
    // is done stays done.
    const kv = try regex.compile(a, "(\\w+)=(\\w*)")
    defer a.free(kv)
    const pairs = "a=1, b=, c=33"
    var it = regex.iter()
    defer a.free(it)
    while (kv.next_captures(a, pairs, &it, &caps)) {
        const k = caps[1] orelse continue
        const v = caps[2] orelse continue
        io.print(pairs[k.start..k.end], " is [", pairs[v.start..v.end], "]")
    }
    io.print(kv.next_captures(a, pairs, &it, &caps), " ", @len(caps))
    show(io, kv.next(a, pairs, &it))
    var words = regex.iter()
    defer a.free(words)
    while (kv.next(a, "x=y z=w", &words)) |m| {
        show(io, m)
    }
    // A long text: the API runs the DFA on it (past MAX_BACKTRACK), and
    // the NFA on the match it finds; backtrack, called itself, grows its
    // stack many times over; all find the same groups.
    var long: Buf(u8) = .empty
    defer a.free(long)
    var w = 0
    while (w < 20000) {
        a.append_str(&long, if (w % 7 == 3) "ab" else "a")
        w = w + 1
    }
    a.append_str(&long, "c!")
    const tail = try regex.compile(a, "(a|ab)*(c)")
    defer a.free(tail)
    if (tail.captures(a, long, &caps)) {
        for (caps) |c| {
            show(io, c)
        }
    }
    var slots: Buf(i64) = .empty
    defer a.free(slots)
    if (regex.backtrack(tail, a, long, 0, @len(long), 6, &slots)) {
        io.print(slots[0], "-", slots[1], " ", slots[2], "-", slots[3], " ", slots[4], "-", slots[5])
    }
    io.print(regex.pike(tail, a, long, 0, @len(long), 0, true, &slots), " ", regex.backtrack(tail, a, long, 0, @len(long), 0, &slots))
    const none = try regex.compile(a, "a")
    defer a.free(none)
    io.print(none.group_count(), " ", none.is_match(a, "bab"), " ", none.is_match(a, "bbb"))
}
