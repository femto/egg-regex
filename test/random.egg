// Random patterns, made by test/gen, each on a few random texts:
// test/random.expected is what Go's regexp says of them (test/go).
uses alloc, io

const check = @import("lib/check.egg")

fn main(io: Io, a: Allocator) void {
    var n = 0
    check.t(io, a, &n, "b", "aaaaba")
    check.t(io, a, &n, "b", "b b")
    check.t(io, a, &n, "b", "")
    check.t(io, a, &n, ".", " bbb ")
    check.t(io, a, &n, ".", "aa bab")
    check.t(io, a, &n, ".", "baaa ab ")
    check.t(io, a, &n, "bb", "")
    check.t(io, a, &n, "bb", "bbaa   ")
    check.t(io, a, &n, "bb", "aaaaa")
    check.t(io, a, &n, ".?", " a")
    check.t(io, a, &n, ".?", " bbb aa ")
    check.t(io, a, &n, ".?", "")
    check.t(io, a, &n, "a+$", "b aaba b")
    check.t(io, a, &n, "a+$", "")
    check.t(io, a, &n, "a+$", " aaabba")
    check.t(io, a, &n, "a*ba+", "")
    check.t(io, a, &n, "a*ba+", "bbab")
    check.t(io, a, &n, "a*ba+", "ba")
    check.t(io, a, &n, "(?:.$a)*b(a*?b?|((^|$[a-b ])+(?:\\w?a+?[ab]|b)+)*(b*)*a(?:aa|[ab]()([a-b ]?b+a|a?b+.)+?b|(a+b*){0})|)*?b", "b")
    check.t(io, a, &n, "(?:.$a)*b(a*?b?|((^|$[a-b ])+(?:\\w?a+?[ab]|b)+)*(b*)*a(?:aa|[ab]()([a-b ]?b+a|a?b+.)+?b|(a+b*){0})|)*?b", "ab")
    check.t(io, a, &n, "(?:.$a)*b(a*?b?|((^|$[a-b ])+(?:\\w?a+?[ab]|b)+)*(b*)*a(?:aa|[ab]()([a-b ]?b+a|a?b+.)+?b|(a+b*){0})|)*?b", "ab a aa")
    check.t(io, a, &n, "a*bb{0}", " a bab")
    check.t(io, a, &n, "a*bb{0}", "b")
    check.t(io, a, &n, "a*bb{0}", "a")
    check.t(io, a, &n, "^a+.", " abb")
    check.t(io, a, &n, "^a+.", "   bb")
    check.t(io, a, &n, "^a+.", "baba")
    check.t(io, a, &n, "\\w\\w{2,}(?:\\b+?aa?a+)?a", "b bab ")
    check.t(io, a, &n, "\\w\\w{2,}(?:\\b+?aa?a+)?a", "a a")
    check.t(io, a, &n, "\\w\\w{2,}(?:\\b+?aa?a+)?a", "aaa")
    check.t(io, a, &n, "[^a]b{2,2}", "a a")
    check.t(io, a, &n, "[^a]b{2,2}", " bb b b ")
    check.t(io, a, &n, "[^a]b{2,2}", "ba ")
    check.t(io, a, &n, "[^a]*", "bbb aa")
    check.t(io, a, &n, "[^a]*", "bba  aab")
    check.t(io, a, &n, "[^a]*", "")
    check.t(io, a, &n, "\\s{0,}^", "ba")
    check.t(io, a, &n, "\\s{0,}^", "bba")
    check.t(io, a, &n, "\\s{0,}^", "")
    check.t(io, a, &n, "\\B(b?b\\w)|\\s{0}\\w{1,3}", "abb")
    check.t(io, a, &n, "\\B(b?b\\w)|\\s{0}\\w{1,3}", "a  bbb")
    check.t(io, a, &n, "\\B(b?b\\w)|\\s{0}\\w{1,3}", "baaab")
    check.t(io, a, &n, "(((a)(?:a{2,2}){1,3}a+?)|(?:(aa*?a?b{2,})*)b*a).", "a")
    check.t(io, a, &n, "(((a)(?:a{2,2}){1,3}a+?)|(?:(aa*?a?b{2,})*)b*a).", " b bba a")
    check.t(io, a, &n, "(((a)(?:a{2,2}){1,3}a+?)|(?:(aa*?a?b{2,})*)b*a).", "")
    check.t(io, a, &n, "b.(\\s{2,})*?|\\s??a.*?(a?$)|[^a]", "baa")
    check.t(io, a, &n, "b.(\\s{2,})*?|\\s??a.*?(a?$)|[^a]", "")
    check.t(io, a, &n, "b.(\\s{2,})*?|\\s??a.*?(a?$)|[^a]", "a")
    check.t(io, a, &n, "(a*((?:\\wa.)+?a*?a*)((?:.a?).a))+((\\w+?|b?[^a]a{1,})+)*", "b ")
    check.t(io, a, &n, "(a*((?:\\wa.)+?a*?a*)((?:.a?).a))+((\\w+?|b?[^a]a{1,})+)*", " a  aa ")
    check.t(io, a, &n, "(a*((?:\\wa.)+?a*?a*)((?:.a?).a))+((\\w+?|b?[^a]a{1,})+)*", "bbbbb")
    check.t(io, a, &n, "ab", "bba")
    check.t(io, a, &n, "ab", "b")
    check.t(io, a, &n, "ab", "a ")
    check.t(io, a, &n, "[ab]", "baa aa")
    check.t(io, a, &n, "[ab]", " a")
    check.t(io, a, &n, "[ab]", " aab")
    check.t(io, a, &n, ".+b{2}(a+?)?", " ")
    check.t(io, a, &n, ".+b{2}(a+?)?", "b ")
    check.t(io, a, &n, ".+b{2}(a+?)?", "aabaab")
    check.t(io, a, &n, "\\B{0,2}|(a){2,3}b{1,2}", " aaaabb")
    check.t(io, a, &n, "\\B{0,2}|(a){2,3}b{1,2}", " bbb  b")
    check.t(io, a, &n, "\\B{0,2}|(a){2,3}b{1,2}", "babb ba")
    check.t(io, a, &n, "\\s?", "")
    check.t(io, a, &n, "\\s?", "bab baab")
    check.t(io, a, &n, "\\s?", "aa  ")
    check.t(io, a, &n, "(a?(?:a{0}|bb?|(b+a{0}b))+a?\\s|\\B(?:(a+baa{1,3}){0,0}){0,2})(.+?[a-b ]{0,})", "ba bbb")
    check.t(io, a, &n, "(a?(?:a{0}|bb?|(b+a{0}b))+a?\\s|\\B(?:(a+baa{1,3}){0,0}){0,2})(.+?[a-b ]{0,})", "a")
    check.t(io, a, &n, "(a?(?:a{0}|bb?|(b+a{0}b))+a?\\s|\\B(?:(a+baa{1,3}){0,0}){0,2})(.+?[a-b ]{0,})", " ")
    check.t(io, a, &n, "\\B?ab", "")
    check.t(io, a, &n, "\\B?ab", "b")
    check.t(io, a, &n, "\\B?ab", "bb b aa ")
    check.t(io, a, &n, "(.[a-b ]+|(aa??a??)??(?:(?:a+b?ab)*?))?(?:b(?:[ab]*?a)a+[^a]|a*a+a+){1,1}", "aaabab")
    check.t(io, a, &n, "(.[a-b ]+|(aa??a??)??(?:(?:a+b?ab)*?))?(?:b(?:[ab]*?a)a+[^a]|a*a+a+){1,1}", "ba")
    check.t(io, a, &n, "(.[a-b ]+|(aa??a??)??(?:(?:a+b?ab)*?))?(?:b(?:[ab]*?a)a+[^a]|a*a+a+){1,1}", "bbb")
    check.t(io, a, &n, "((a$|a?)a.{0,}\\b+)b\\b*", "")
    check.t(io, a, &n, "((a$|a?)a.{0,}\\b+)b\\b*", "")
    check.t(io, a, &n, "((a$|a?)a.{0,}\\b+)b\\b*", "bbaab")
    check.t(io, a, &n, "($)??([a-b ]((?:b{1,}))\\b+)$", " b")
    check.t(io, a, &n, "($)??([a-b ]((?:b{1,}))\\b+)$", "a ")
    check.t(io, a, &n, "($)??([a-b ]((?:b{1,}))\\b+)$", "b b")
    check.t(io, a, &n, ".?", "b")
    check.t(io, a, &n, ".?", "babab")
    check.t(io, a, &n, ".?", "a b bbaa")
    check.t(io, a, &n, "[^a]?a*", "aaa")
    check.t(io, a, &n, "[^a]?a*", "ab abb")
    check.t(io, a, &n, "[^a]?a*", "b")
    check.t(io, a, &n, "b?b+?((?:a?[^a]*?a)*bb?|a((.{2,})+\\b[^a]*)).+", "aa b")
    check.t(io, a, &n, "b?b+?((?:a?[^a]*?a)*bb?|a((.{2,})+\\b[^a]*)).+", "bb")
    check.t(io, a, &n, "b?b+?((?:a?[^a]*?a)*bb?|a((.{2,})+\\b[^a]*)).+", "")
    check.t(io, a, &n, "(.(?:(?:aa+)\\s|(.{1,}\\wb){1,3}(\\s?.*?b+)+[ab]+){1}(a+|(?:[^a]bab{1,})*a?)a|.??(?:(|b)a(^))(?:.(ab+?b\\B)*a))??b?", "bbaaa bb")
    check.t(io, a, &n, "(.(?:(?:aa+)\\s|(.{1,}\\wb){1,3}(\\s?.*?b+)+[ab]+){1}(a+|(?:[^a]bab{1,})*a?)a|.??(?:(|b)a(^))(?:.(ab+?b\\B)*a))??b?", "aab")
    check.t(io, a, &n, "(.(?:(?:aa+)\\s|(.{1,}\\wb){1,3}(\\s?.*?b+)+[ab]+){1}(a+|(?:[^a]bab{1,})*a?)a|.??(?:(|b)a(^))(?:.(ab+?b\\B)*a))??b?", "aba")
    check.t(io, a, &n, "a{1,}|(?:aaa(?:a[a-b ]??)*)\\b", " ")
    check.t(io, a, &n, "a{1,}|(?:aaa(?:a[a-b ]??)*)\\b", " bba")
    check.t(io, a, &n, "a{1,}|(?:aaa(?:a[a-b ]??)*)\\b", "b a")
    check.t(io, a, &n, "a{0,1}", "ba baab")
    check.t(io, a, &n, "a{0,1}", "b")
    check.t(io, a, &n, "a{0,1}", "ab")
    check.t(io, a, &n, "aa+(?:([ab]{0,1}(a{1}.){2}b){2,3}[ab]|.+(.*)+?a?)a", " b")
    check.t(io, a, &n, "aa+(?:([ab]{0,1}(a{1}.){2}b){2,3}[ab]|.+(.*)+?a?)a", "  ")
    check.t(io, a, &n, "aa+(?:([ab]{0,1}(a{1}.){2}b){2,3}[ab]|.+(.*)+?a?)a", "baaa")
    check.t(io, a, &n, "[ab]ba\\s*", "bbaabaaa")
    check.t(io, a, &n, "[ab]ba\\s*", "")
    check.t(io, a, &n, "[ab]ba\\s*", "bb a ")
    check.t(io, a, &n, "aaa|.*?a+.", "aa")
    check.t(io, a, &n, "aaa|.*?a+.", "")
    check.t(io, a, &n, "aaa|.*?a+.", " bba")
    check.t(io, a, &n, "((bb?|[^a](?:aa)|b+\\b)(b*ab*.))*[^a]?\\b?|", " ba ")
    check.t(io, a, &n, "((bb?|[^a](?:aa)|b+\\b)(b*ab*.))*[^a]?\\b?|", "aa")
    check.t(io, a, &n, "((bb?|[^a](?:aa)|b+\\b)(b*ab*.))*[^a]?\\b?|", "b  aab")
    check.t(io, a, &n, ".+", "abb aa")
    check.t(io, a, &n, ".+", "aaba ")
    check.t(io, a, &n, ".+", "aba ")
    check.t(io, a, &n, "b{2,}ab+?", "aa")
    check.t(io, a, &n, "b{2,}ab+?", "bbaba ")
    check.t(io, a, &n, "b{2,}ab+?", "bbab")
    check.t(io, a, &n, "", "bb")
    check.t(io, a, &n, "", "baa aab")
    check.t(io, a, &n, "", "")
    check.t(io, a, &n, "a$(a(.a+(a?a{0,0}a??)*|b(?:.??b)*?aa)?a|a\\w|\\b|(bb+.a*|a){2,}($)+){0,2}|$b*a?[ab]*", "b")
    check.t(io, a, &n, "a$(a(.a+(a?a{0,0}a??)*|b(?:.??b)*?aa)?a|a\\w|\\b|(bb+.a*|a){2,}($)+){0,2}|$b*a?[ab]*", "b bbbbaa")
    check.t(io, a, &n, "a$(a(.a+(a?a{0,0}a??)*|b(?:.??b)*?aa)?a|a\\w|\\b|(bb+.a*|a){2,}($)+){0,2}|$b*a?[ab]*", "bbbba ")
    check.t(io, a, &n, "((?:(?:ab*?)a{1,}a{0}))*[^a]*(((a*a+[ab]b|a|a)$b?){1,}a?ba{2,})*.|(\\sa((b).*?a|($b+)\\s*aa{2,2}))|.(a*.*(a))a?", "")
    check.t(io, a, &n, "((?:(?:ab*?)a{1,}a{0}))*[^a]*(((a*a+[ab]b|a|a)$b?){1,}a?ba{2,})*.|(\\sa((b).*?a|($b+)\\s*aa{2,2}))|.(a*.*(a))a?", "ababab")
    check.t(io, a, &n, "((?:(?:ab*?)a{1,}a{0}))*[^a]*(((a*a+[ab]b|a|a)$b?){1,}a?ba{2,})*.|(\\sa((b).*?a|($b+)\\s*aa{2,2}))|.(a*.*(a))a?", "ababa")
    check.t(io, a, &n, "b+bb\\b{1,2}", "a bbbaaa")
    check.t(io, a, &n, "b+bb\\b{1,2}", "")
    check.t(io, a, &n, "b+bb\\b{1,2}", "aa")
    check.t(io, a, &n, "b*", "bbabb")
    check.t(io, a, &n, "b*", "")
    check.t(io, a, &n, "b*", "  ababb")
    check.t(io, a, &n, ".|a{2}^", "babab")
    check.t(io, a, &n, ".|a{2}^", " ")
    check.t(io, a, &n, ".|a{2}^", "a")
    check.t(io, a, &n, "ba+(?:a{0,})a|\\B?a??((\\sa.|(a?b){1}^)??.|$a{1,2})+b", "b")
    check.t(io, a, &n, "ba+(?:a{0,})a|\\B?a??((\\sa.|(a?b){1}^)??.|$a{1,2})+b", " ")
    check.t(io, a, &n, "ba+(?:a{0,})a|\\B?a??((\\sa.|(a?b){1}^)??.|$a{1,2})+b", "bbabbab")
    check.t(io, a, &n, "b(?:(^b(?:[ab]+a?)+(?:.))*($a?)\\b*(?:[ab](b{2,4}a|bb\\B+a?))??)", "aaaaaaab")
    check.t(io, a, &n, "b(?:(^b(?:[ab]+a?)+(?:.))*($a?)\\b*(?:[ab](b{2,4}a|bb\\B+a?))??)", "baa ")
    check.t(io, a, &n, "b(?:(^b(?:[ab]+a?)+(?:.))*($a?)\\b*(?:[ab](b{2,4}a|bb\\B+a?))??)", "b")
    check.t(io, a, &n, "[ab]+a{1,1}a", "")
    check.t(io, a, &n, "[ab]+a{1,1}a", " ")
    check.t(io, a, &n, "[ab]+a{1,1}a", "ababbab ")
    check.t(io, a, &n, ".*(?:(\\b+a(?:\\s{0,1}$[^a])))?\\wb", " baa")
    check.t(io, a, &n, ".*(?:(\\b+a(?:\\s{0,1}$[^a])))?\\wb", "a")
    check.t(io, a, &n, ".*(?:(\\b+a(?:\\s{0,1}$[^a])))?\\wb", " aaaaaa")
    check.t(io, a, &n, "b.??", "b")
    check.t(io, a, &n, "b.??", "")
    check.t(io, a, &n, "b.??", " a")
    check.t(io, a, &n, "[a-b ](a+(?:a+?)a+?)a+|\\s", "bbbab")
    check.t(io, a, &n, "[a-b ](a+(?:a+?)a+?)a+|\\s", "a ba")
    check.t(io, a, &n, "[a-b ](a+(?:a+?)a+?)a+|\\s", "")
    check.t(io, a, &n, "(?:[ab]*(?:(bba|a*ba)?.+(?:[a-b ]+?a?b??a?))?a?a){0,2}", " ")
    check.t(io, a, &n, "(?:[ab]*(?:(bba|a*ba)?.+(?:[a-b ]+?a?b??a?))?a?a){0,2}", "b")
    check.t(io, a, &n, "(?:[ab]*(?:(bba|a*ba)?.+(?:[a-b ]+?a?b??a?))?a?a){0,2}", "aaabab")
    check.t(io, a, &n, "((?:\\s??a?|a{1,}a|a(a+?|ba|a+|a*a*|a*aa[a-b ]+|b$b|a{2,}$)?b{0}){1,2}a{1}a+?){2,2}a", "bab ")
    check.t(io, a, &n, "((?:\\s??a?|a{1,}a|a(a+?|ba|a+|a*a*|a*aa[a-b ]+|b$b|a{2,}$)?b{0}){1,2}a{1}a+?){2,2}a", "bab ba")
    check.t(io, a, &n, "((?:\\s??a?|a{1,}a|a(a+?|ba|a+|a*a*|a*aa[a-b ]+|b$b|a{2,}$)?b{0}){1,2}a{1}a+?){2,2}a", "a b")
    check.t(io, a, &n, "[^a]*?bb+a", "baabbaab")
    check.t(io, a, &n, "[^a]*?bb+a", "b   b aa")
    check.t(io, a, &n, "[^a]*?bb+a", "aa")
    check.t(io, a, &n, "b?(?:.a*a)*?a|", "")
    check.t(io, a, &n, "b?(?:.a*a)*?a|", "b aababb")
    check.t(io, a, &n, "b?(?:.a*a)*?a|", "b abb")
    check.t(io, a, &n, "b(b$)", "")
    check.t(io, a, &n, "b(b$)", " a ")
    check.t(io, a, &n, "b(b$)", "aaaaaab ")
    check.t(io, a, &n, "b.*\\B|b", "b")
    check.t(io, a, &n, "b.*\\B|b", "aba aaaa")
    check.t(io, a, &n, "b.*\\B|b", "")
    check.t(io, a, &n, "b?.a*|(?:.a+((?:ba{0,}a+)+?))b", "")
    check.t(io, a, &n, "b?.a*|(?:.a+((?:ba{0,}a+)+?))b", " aab")
    check.t(io, a, &n, "b?.a*|(?:.a+((?:ba{0,}a+)+?))b", "")
    check.t(io, a, &n, "(.+\\sa*b?)", "ba")
    check.t(io, a, &n, "(.+\\sa*b?)", "")
    check.t(io, a, &n, "(.+\\sa*b?)", " ")
    check.t(io, a, &n, "[^a][ab]*?(?:){1,}|(a|ab*(ba?\\B*?\\B|b+?b+?.)+)a*", "  ")
    check.t(io, a, &n, "[^a][ab]*?(?:){1,}|(a|ab*(ba?\\B*?\\B|b+?b+?.)+)a*", "abbaab")
    check.t(io, a, &n, "[^a][ab]*?(?:){1,}|(a|ab*(ba?\\B*?\\B|b+?b+?.)+)a*", "")
    check.t(io, a, &n, ".+[ab]?b", "ba a a")
    check.t(io, a, &n, ".+[ab]?b", "ab aa")
    check.t(io, a, &n, ".+[ab]?b", "")
    check.t(io, a, &n, "b", " baba")
    check.t(io, a, &n, "b", " bab")
    check.t(io, a, &n, "b", " ")
    check.t(io, a, &n, "a.*a?(b(\\B(?:bba?)?a*(?:a*?){2,3})(.*\\w+))", "baaa b")
    check.t(io, a, &n, "a.*a?(b(\\B(?:bba?)?a*(?:a*?){2,3})(.*\\w+))", "bb bba")
    check.t(io, a, &n, "a.*a?(b(\\B(?:bba?)?a*(?:a*?){2,3})(.*\\w+))", " ba baba")
    check.t(io, a, &n, ".b(?:(a)+(?:(b)?(b.|b??a?[ab]|b{1,}a.|a)+)?b)+?[a-b ]|b*aaa?", "bbbaab")
    check.t(io, a, &n, ".b(?:(a)+(?:(b)?(b.|b??a?[ab]|b{1,}a.|a)+)?b)+?[a-b ]|b*aaa?", " bb ")
    check.t(io, a, &n, ".b(?:(a)+(?:(b)?(b.|b??a?[ab]|b{1,}a.|a)+)?b)+?[a-b ]|b*aaa?", " aab")
    check.t(io, a, &n, "a.b?", "")
    check.t(io, a, &n, "a.b?", "abab")
    check.t(io, a, &n, "a.b?", "b")
    check.t(io, a, &n, ".*((\\w){1,}\\s$|(aa?)?|.{1,})+", "ba")
    check.t(io, a, &n, ".*((\\w){1,}\\s$|(aa?)?|.{1,})+", "aab")
    check.t(io, a, &n, ".*((\\w){1,}\\s$|(aa?)?|.{1,})+", " abab")
    check.t(io, a, &n, "^^a*", "a ")
    check.t(io, a, &n, "^^a*", "")
    check.t(io, a, &n, "^^a*", " bbbaaa ")
    check.t(io, a, &n, "\\b(a((.*?a|a+aa?).*|(aa*?\\b*)*a*a)a*?)?a??", "ab bb")
    check.t(io, a, &n, "\\b(a((.*?a|a+aa?).*|(aa*?\\b*)*a*a)a*?)?a??", "aabbaba")
    check.t(io, a, &n, "\\b(a((.*?a|a+aa?).*|(aa*?\\b*)*a*a)a*?)?a??", " a")
    check.t(io, a, &n, "b*", " ab a")
    check.t(io, a, &n, "b*", "bbabb aa")
    check.t(io, a, &n, "b*", " b")
    check.t(io, a, &n, "(?:(($\\w*^)a(?:[^a].a|ab?)*?)+^.?)a|b", "ba bbab")
    check.t(io, a, &n, "(?:(($\\w*^)a(?:[^a].a|ab?)*?)+^.?)a|b", "aa")
    check.t(io, a, &n, "(?:(($\\w*^)a(?:[^a].a|ab?)*?)+^.?)a|b", "    bb ")
    check.t(io, a, &n, "(?:(?:(?:a{2,3}b*?b))a)b?(?:(\\w?$(bb?ba*?))*|^)?", "a ")
