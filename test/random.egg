// Random patterns, made by test/gen, each on a few random texts:
// test/random.expected is what Go's regexp says of them (test/go).
uses alloc, io

const check = @import("lib/check.egg")

fn main(io: Io, a: Allocator) void {
    var n = 0
    check.t(io, a, &n, "b", "aςb aba")
    check.t(io, a, &n, "b", "")
    check.t(io, a, &n, "b", "bbaas")
    check.t(io, a, &n, "(((a*b+?b|aab*a)??\\pL(?:.?)))b{1,}b*b+?", " basés ")
    check.t(io, a, &n, "(((a*b+?b|aab*a)??\\pL(?:.?)))b{1,}b*b+?", "aba")
    check.t(io, a, &n, "(((a*b+?b|aab*a)??\\pL(?:.?)))b{1,}b*b+?", "K\u{212a}b\u{212a}")
    check.t(io, a, &n, "a+\\w?((?:.$a)*b(a*?b?|(a*^|$\\PL)+(?:\\p{Greek}?a+?\\s|b)+(?:ba*?|baab)*|a+a|[[:upper:]]?b+a|a?b+.)+?b|((b*){0}(a*)*?b)){0,1}a{1,1}", "a bbbabb")
    check.t(io, a, &n, "a+\\w?((?:.$a)*b(a*?b?|(a*^|$\\PL)+(?:\\p{Greek}?a+?\\s|b)+(?:ba*?|baab)*|a+a|[[:upper:]]?b+a|a?b+.)+?b|((b*){0}(a*)*?b)){0,1}a{1,1}", "a")
    check.t(io, a, &n, "a+\\w?((?:.$a)*b(a*?b?|(a*^|$\\PL)+(?:\\p{Greek}?a+?\\s|b)+(?:ba*?|baab)*|a+a|[[:upper:]]?b+a|a?b+.)+?b|((b*){0}(a*)*?b)){0,1}a{1,1}", "bb")
    check.t(io, a, &n, ".b??[ab](b+?|aab{0}\\p{Greek}{2,})", "a")
    check.t(io, a, &n, ".b??[ab](b+?|aab{0}\\p{Greek}{2,})", "bsb a a")
    check.t(io, a, &n, ".b??[ab](b+?|aab{0}\\p{Greek}{2,})", "a aa")
    check.t(io, a, &n, "(ab{2,2})*", "Σé\u{212a} é a\u{17f}")
    check.t(io, a, &n, "(ab{2,2})*", "bb aba")
    check.t(io, a, &n, "(ab{2,2})*", "Σbb")
    check.t(io, a, &n, "b{0,}^", "abbaa")
    check.t(io, a, &n, "b{0,}^", "")
    check.t(io, a, &n, "b{0,}^", "babbba\u{17f}")
    check.t(io, a, &n, "(?i)b{0,2}", " ba b")
    check.t(io, a, &n, "(?i)b{0,2}", "\u{212a}a\u{212a}a ba")
    check.t(io, a, &n, "(?i)b{0,2}", "aa\u{212a}bab")
    check.t(io, a, &n, "(a+?(?:a{1,}(aa*?a?b{2,})*.b*|a.a+$)(?:b)*b{1})([ab]{2,})*?b[[:upper:]]??", "abςas")
    check.t(io, a, &n, "(a+?(?:a{1,}(aa*?a?b{2,})*.b*|a.a+$)(?:b)*b{1})([ab]{2,})*?b[[:upper:]]??", "b")
    check.t(io, a, &n, "(a+?(?:a{1,}(aa*?a?b{2,})*.b*|a.a+$)(?:b)*b{1})([ab]{2,})*?b[[:upper:]]??", "abasbbab")
    check.t(io, a, &n, "(?:(a)a+?a*?)*.((?:.a?).a)", "bbé aa")
    check.t(io, a, &n, "(?:(a)a+?a*?)*.((?:.a?).a)", "aaabbb")
    check.t(io, a, &n, "(?:(a)a+?a*?)*.((?:.a?).a)", " ")
    check.t(io, a, &n, "a", "bbbba")
    check.t(io, a, &n, "a", "ς\u{17f}ébaa")
    check.t(io, a, &n, "a", "σbéaa")
    check.t(io, a, &n, "", "aba ")
    check.t(io, a, &n, "", "aaa b bs")
    check.t(io, a, &n, "", "aabbbK")
    check.t(io, a, &n, "(?i)b|(a)+?b+", " aaé b b")
    check.t(io, a, &n, "(?i)b|(a)+?b+", "sbbaσσb")
    check.t(io, a, &n, "(?i)b|(a)+?b+", "bb")
    check.t(io, a, &n, "a", "s")
    check.t(io, a, &n, "a", "aΣbb\u{212a}")
    check.t(io, a, &n, "a", "as")
    check.t(io, a, &n, "b{0}", "aς ")
    check.t(io, a, &n, "b{0}", "")
    check.t(io, a, &n, "b{0}", "a a ab")
    check.t(io, a, &n, "b+a+|(σ??.{0,0}){0,2}", "  ")
    check.t(io, a, &n, "b+a+|(σ??.{0,0}){0,2}", "\u{212a}aaab b")
    check.t(io, a, &n, "b+a+|(σ??.{0,0}){0,2}", "a bb\u{17f}abb")
    check.t(io, a, &n, "a|\\PL..", "abb\u{17f}  ")
    check.t(io, a, &n, "a|\\PL..", "b ")
    check.t(io, a, &n, "a|\\PL..", "b ")
    check.t(io, a, &n, "\\B?", "")
    check.t(io, a, &n, "\\B?", "")
    check.t(io, a, &n, "\\B?", " bb")
    check.t(io, a, &n, "b?(..*?a)a+", "ςaasb ς\u{17f}")
    check.t(io, a, &n, "b?(..*?a)a+", "bbbb\u{17f}bba")
    check.t(io, a, &n, "b?(..*?a)a+", "")
    check.t(io, a, &n, "$a*|a+?.{0,}\\b+", "aba ")
    check.t(io, a, &n, "$a*|a+?.{0,}\\b+", "babaa")
    check.t(io, a, &n, "$a*|a+?.{0,}\\b+", "bbK")
    check.t(io, a, &n, "(?i)((?:(?:$aa)?))aa*?(^(a.?\\b){2}.{2,4}a+?)+", "babaab")
    check.t(io, a, &n, "(?i)((?:(?:$aa)?))aa*?(^(a.?\\b){2}.{2,4}a+?)+", "\u{17f}ab")
    check.t(io, a, &n, "(?i)((?:(?:$aa)?))aa*?(^(a.?\\b){2}.{2,4}a+?)+", "bbaabσ")
    check.t(io, a, &n, "(?i)\\w*b?", "b")
    check.t(io, a, &n, "(?i)\\w*b?", "aΣbaba")
    check.t(io, a, &n, "(?i)\\w*b?", "a\u{212a}ςabab")
    check.t(io, a, &n, "\\PLb|.?", "aab a")
    check.t(io, a, &n, "\\PLb|.?", "")
    check.t(io, a, &n, "\\PLb|.?", "")
    check.t(io, a, &n, "", "b\u{212a} bab")
    check.t(io, a, &n, "", "bbΣbbaa")
    check.t(io, a, &n, "", "abbbéσ")
    check.t(io, a, &n, "(?i)b{2}(?:(b{1,}a*a?a)b*)??(?:(|(?:aa)?)a((?:.aab+?)))", "")
    check.t(io, a, &n, "(?i)b{2}(?:(b{1,}a*a?a)b*)??(?:(|(?:aa)?)a((?:.aab+?)))", "b  bb")
    check.t(io, a, &n, "(?i)b{2}(?:(b{1,}a*a?a)b*)??(?:(|(?:aa)?)a((?:.aab+?)))", "a b\u{212a}ba")
    check.t(io, a, &n, "b?((?:(aa))ak??)*", "b ")
    check.t(io, a, &n, "b?((?:(aa))ak??)*", "baba")
    check.t(io, a, &n, "b?((?:(aa))ak??)*", "bbbb ")
    check.t(io, a, &n, "b+b*[ab]+", "aa bbab")
    check.t(io, a, &n, "b+b*[ab]+", "babb")
    check.t(io, a, &n, "b+b*[ab]+", "a ΣbΣb\u{212a}a")
    check.t(io, a, &n, ".*", "b  a")
    check.t(io, a, &n, ".*", "a bas")
    check.t(io, a, &n, ".*", "")
    check.t(io, a, &n, "a?a{0}", "babσbb  ")
    check.t(io, a, &n, "a?a{0}", "baaς")
    check.t(io, a, &n, "a?a{0}", "aéaaaΣba")
    check.t(io, a, &n, "((bb?|\\pL(?:aa)|b+\\b)(b*ab*.))*σ?\\b?|^aaa*", "σabbb\u{17f}")
    check.t(io, a, &n, "((bb?|\\pL(?:aa)|b+\\b)(b*ab*.))*σ?\\b?|^aaa*", " ")
    check.t(io, a, &n, "((bb?|\\pL(?:aa)|b+\\b)(b*ab*.))*σ?\\b?|^aaa*", "aaa")
    check.t(io, a, &n, "b*a+a?|b{2}", "babaabb")
    check.t(io, a, &n, "b*a+a?|b{2}", "abbςa a")
    check.t(io, a, &n, "b*a+a?|b{2}", "\u{17f}\u{17f}aab")
    check.t(io, a, &n, "[ab]a+", " b ΣaΣéa")
    check.t(io, a, &n, "[ab]a+", "baa ")
    check.t(io, a, &n, "[ab]a+", "sKbKaa")
    check.t(io, a, &n, "(?i)\\pLa*\\b((bb+.a*|a){2,}($)+){0,2}", "b")
    check.t(io, a, &n, "(?i)\\pLa*\\b((bb+.a*|a){2,}($)+){0,2}", "\u{17f}")
    check.t(io, a, &n, "(?i)\\pLa*\\b((bb+.a*|a){2,}($)+){0,2}", "a\u{212a}a")
    check.t(io, a, &n, "(a..{0}(?:(^a*)*))+\\bb(?:a|b([a-b ]\\pL|(a*a+\\PLb|a|a)$b?){1,}a?|a{2,}^)|\\w{2,}", "bbb ba b")
    check.t(io, a, &n, "(a..{0}(?:(^a*)*))+\\bb(?:a|b([a-b ]\\pL|(a*a+\\PLb|a|a)$b?){1,}a?|a{2,}^)|\\w{2,}", "baasb")
    check.t(io, a, &n, "(a..{0}(?:(^a*)*))+\\bb(?:a|b([a-b ]\\pL|(a*a+\\PLb|a|a)$b?){1,}a?|a{2,}^)|\\w{2,}", "b")
    check.t(io, a, &n, "(a)", "bΣb σ aK")
    check.t(io, a, &n, "(a)", "aas")
    check.t(io, a, &n, "(a)", "")
    check.t(io, a, &n, "aσb+", "")
    check.t(io, a, &n, "aσb+", "b")
    check.t(io, a, &n, "aσb+", "bb b ba")
    check.t(io, a, &n, "(?i)baσ", "bbb a")
    check.t(io, a, &n, "(?i)baσ", "bb ςba")
    check.t(io, a, &n, "(?i)baσ", "a ")
    check.t(io, a, &n, "k", "a ab")
    check.t(io, a, &n, "k", "bb")
    check.t(io, a, &n, "k", " a b\u{212a}ab ")
    check.t(io, a, &n, "(?i)\\p{Greek}", "ba  ")
    check.t(io, a, &n, "(?i)\\p{Greek}", "")
    check.t(io, a, &n, "(?i)\\p{Greek}", "s")
    check.t(io, a, &n, "(?i)\\s|a", "bbabbb")
    check.t(io, a, &n, "(?i)\\s|a", "babb a")
    check.t(io, a, &n, "(?i)\\s|a", "a bbΣa")
    check.t(io, a, &n, "a+(?:.)a*", "bbab")
    check.t(io, a, &n, "a+(?:.)a*", "a\u{17f}b a a")
    check.t(io, a, &n, "a+(?:.)a*", "bΣbab")
    check.t(io, a, &n, "(?i)((?:a$a)+.\\PL*?((a)a{1,1}a)+?)?b", "bsa")
    check.t(io, a, &n, "(?i)((?:a$a)+.\\PL*?((a)a{1,1}a)+?)?b", "\u{212a}")
    check.t(io, a, &n, "(?i)((?:a$a)+.\\PL*?((a)a{1,1}a)+?)?b", "a ς")
    check.t(io, a, &n, "\\pL{0,1}$\\pL", "b\u{17f}\u{212a} bbsa")
    check.t(io, a, &n, "\\pL{0,1}$\\pL", "aKaaa a")
    check.t(io, a, &n, "\\pL{0,1}$\\pL", " ")
    check.t(io, a, &n, ".\\b|a+(?:a+?)a+?", "ba")
    check.t(io, a, &n, ".\\b|a+(?:a+?)a+?", "\u{17f}ab\u{212a}baσb")
    check.t(io, a, &n, ".\\b|a+(?:a+?)a+?", "aσaσb ba")
    check.t(io, a, &n, "a*(?:a(.+))?(a?b??(..?a?)){0,2}", "baaaσ")
    check.t(io, a, &n, "a*(?:a(.+))?(a?b??(..?a?)){0,2}", "")
    check.t(io, a, &n, "a*(?:a(.+))?(a?b??(..?a?)){0,2}", "béab a")
    check.t(io, a, &n, "b+aa*|a+", "\u{212a}baa")
    check.t(io, a, &n, "b+aa*|a+", "a aaé\u{17f}ba")
    check.t(io, a, &n, "b+aa*|a+", "")
    check.t(io, a, &n, "(?i).?[ab]$b", "\u{212a}abéab")
    check.t(io, a, &n, "(?i).?[ab]$b", "babς")
    check.t(io, a, &n, "(?i).?[ab]$b", "aabbbaς")
    check.t(io, a, &n, "a+$", " b\u{17f}")
    check.t(io, a, &n, "a+$", "bbaab")
    check.t(io, a, &n, "a+$", "")
    check.t(io, a, &n, "b", "b ba")
    check.t(io, a, &n, "b", "a\u{17f}b")
    check.t(io, a, &n, "b", " aςa")
    check.t(io, a, &n, "b*b?b+?b*?", "abbab")
    check.t(io, a, &n, "b*b?b+?b*?", "a a")
    check.t(io, a, &n, "b*b?b+?b*?", "a")
    check.t(io, a, &n, "\\B(?:(b*)*^(?:a?a*?)+|b){2,4}|ba", "b aσ")
    check.t(io, a, &n, "\\B(?:(b*)*^(?:a?a*?)+|b){2,4}|ba", "a\u{17f}bbs  ")
    check.t(io, a, &n, "\\B(?:(b*)*^(?:a?a*?)+|b){2,4}|ba", "a aa")
    check.t(io, a, &n, "bb", "ba")
    check.t(io, a, &n, "bb", "bbbabé")
    check.t(io, a, &n, "bb", "bs ")
    check.t(io, a, &n, "\\p{Greek}k*?(?:){1,}", "aaaaba a")
    check.t(io, a, &n, "\\p{Greek}k*?(?:){1,}", "")
    check.t(io, a, &n, "\\p{Greek}k*?(?:){1,}", " ")
    check.t(io, a, &n, "\\Bb+?\\B|a*?$", "aa")
    check.t(io, a, &n, "\\Bb+?\\B|a*?$", "a")
    check.t(io, a, &n, "\\Bb+?\\B|a*?$", "")
    check.t(io, a, &n, "(bk*?[^a]?)a+?\\s*a+", "a Σa aa ")
    check.t(io, a, &n, "(bk*?[^a]?)a+?\\s*a+", "b a")
    check.t(io, a, &n, "(bk*?[^a]?)a+?\\s*a+", "a")
    check.t(io, a, &n, "ba??", " ")
    check.t(io, a, &n, "ba??", "abbb")
    check.t(io, a, &n, "ba??", "\u{17f}b\u{212a}abb σ")
    check.t(io, a, &n, ".*k+", " ba")
    check.t(io, a, &n, ".*k+", "bς ba")
    check.t(io, a, &n, ".*k+", "a")
    check.t(io, a, &n, "(?i)(\\pL.|(?:(a)+(?:ab)?(b.|b??a?\\p{Greek}|b{1,}a.|a)+\\PL*?).)|b*aaa?", "Σab b ")
    check.t(io, a, &n, "(?i)(\\pL.|(?:(a)+(?:ab)?(b.|b??a?\\p{Greek}|b{1,}a.|a)+\\PL*?).)|b*aaa?", "aé")
    check.t(io, a, &n, "(?i)(\\pL.|(?:(a)+(?:ab)?(b.|b??a?\\p{Greek}|b{1,}a.|a)+\\PL*?).)|b*aaa?", "bab")
    check.t(io, a, &n, "(.a{1}.+b)*?\\s", "a")
    check.t(io, a, &n, "(.a{1}.+b)*?\\s", " aabσ")
    check.t(io, a, &n, "(.a{1}.+b)*?\\s", "abbbbaa")
    check.t(io, a, &n, "aa", "bb")
    check.t(io, a, &n, "aa", "bbab abb")
    check.t(io, a, &n, "aa", "aa")
    check.t(io, a, &n, "(?i)a(a((.*?a|a+aa?).*|(aa*?\\b*)*a*a)a*?)?a??^", "bab")
    check.t(io, a, &n, "(?i)a(a((.*?a|a+aa?).*|(aa*?\\b*)*a*a)a*?)?a??^", "baa")
    check.t(io, a, &n, "(?i)a(a((.*?a|a+aa?).*|(aa*?\\b*)*a*a)a*?)?a??^", "aba")
    check.t(io, a, &n, "(.|b[a-b ]a+?a*)a.\\b", "aasb b ")
    check.t(io, a, &n, "(.|b[a-b ]a+?a*)a.\\b", "b ")
    check.t(io, a, &n, "(.|b[a-b ]a+?a*)a.\\b", "")
    check.t(io, a, &n, "aa\\PL", "bab\u{212a}")
    check.t(io, a, &n, "aa\\PL", "")
    check.t(io, a, &n, "aa\\PL", "")
    check.t(io, a, &n, "a.*^a|(?:(?:(?:b?){2,3}b*?(?:.\\B*?a))(\\B)?$|bb?ba*?)", "a ba")
    check.t(io, a, &n, "a.*^a|(?:(?:(?:b?){2,3}b*?(?:.\\B*?a))(\\B)?$|bb?ba*?)", "bbb a")
    check.t(io, a, &n, "a.*^a|(?:(?:(?:b?){2,3}b*?(?:.\\B*?a))(\\B)?$|bb?ba*?)", "σaba")
    check.t(io, a, &n, "(?i)b*?|a?.?", " abbaς")
    check.t(io, a, &n, "(?i)b*?|a?.?", " b a")
    check.t(io, a, &n, "(?i)b*?|a?.?", "babaa ")
    check.t(io, a, &n, "a+b", "abbb bb")
    check.t(io, a, &n, "a+b", "aba")
    check.t(io, a, &n, "a+b", " basa\u{212a}b")
    check.t(io, a, &n, "a*", "Σ")
    check.t(io, a, &n, "a*", "aa")
    check.t(io, a, &n, "a*", "")
    check.t(io, a, &n, "(?i)\\b{2,}a\\p{Greek}", "σbaK")
    check.t(io, a, &n, "(?i)\\b{2,}a\\p{Greek}", "")
    check.t(io, a, &n, "(?i)\\b{2,}a\\p{Greek}", "b σ")
    check.t(io, a, &n, "(?:b)((?:a(?:ab+a)k|.+){0}^|a(b*\\s(a.){1})*b?)?a^|\\p{Greek}+.|a{2,}a?a+?(((?:b?)*.*?a)*)+", "aas")
    check.t(io, a, &n, "(?:b)((?:a(?:ab+a)k|.+){0}^|a(b*\\s(a.){1})*b?)?a^|\\p{Greek}+.|a{2,}a?a+?(((?:b?)*.*?a)*)+", "aaΣa  ba")
    check.t(io, a, &n, "(?:b)((?:a(?:ab+a)k|.+){0}^|a(b*\\s(a.){1})*b?)?a^|\\p{Greek}+.|a{2,}a?a+?(((?:b?)*.*?a)*)+", "ab ba a")
    check.t(io, a, &n, "((?:(?:\\s+b|aa)(a*aa)a\\s?))", "Kbbbsbba")
    check.t(io, a, &n, "((?:(?:\\s+b|aa)(a*aa)a\\s?))", "\u{212a}")
    check.t(io, a, &n, "((?:(?:\\s+b|aa)(a*aa)a\\s?))", "abba")
    check.t(io, a, &n, "(?:a)??", "ab")
    check.t(io, a, &n, "(?:a)??", "bsbaa")
    check.t(io, a, &n, "(?:a)??", "")
    check.t(io, a, &n, "(?i)(a??^(b(ba)*?)+?)", "abb")
    check.t(io, a, &n, "(?i)(a??^(b(ba)*?)+?)", "baaa  ")
    check.t(io, a, &n, "(?i)(a??^(b(ba)*?)+?)", "")
    check.t(io, a, &n, "(?i)a", "")
    check.t(io, a, &n, "(?i)a", "a")
    check.t(io, a, &n, "(?i)a", "ba")
    check.t(io, a, &n, "((b*?(a??|a{2,}a+)*a{0,1})?b?)+", "b\u{17f}")
    check.t(io, a, &n, "((b*?(a??|a{2,}a+)*a{0,1})?b?)+", " aaba ")
    check.t(io, a, &n, "((b*?(a??|a{2,}a+)*a{0,1})?b?)+", " aaab\u{212a} ")
    check.t(io, a, &n, "(?i)|(?:baa+|bb^b).b{2,}\\B", "abbb\u{212a}")
    check.t(io, a, &n, "(?i)|(?:baa+|bb^b).b{2,}\\B", "  aba")
    check.t(io, a, &n, "(?i)|(?:baa+|bb^b).b{2,}\\B", "")
    check.t(io, a, &n, "(?i)(($)+a?.+?(a??a?\\B?(?:a{2}bb{0,}|a?ba?))*?)[^a]??|a|a??a{2,3}(((?:bσ|a^.\\b|a*)?(?:a*)??a?))*", "a")
    check.t(io, a, &n, "(?i)(($)+a?.+?(a??a?\\B?(?:a{2}bb{0,}|a?ba?))*?)[^a]??|a|a??a{2,3}(((?:bσ|a^.\\b|a*)?(?:a*)??a?))*", " bKb b")
