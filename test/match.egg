// Matching, case by case (test/lib/check.egg). test/match.expected is
// what Go's regexp, which has RE2's semantics, says of the same cases:
// test/go makes it from this file. Where this package differs from Go on
// purpose, the case is in test/errors.egg instead.
uses alloc, io

const check = @import("lib/check.egg")

fn main(io: Io, a: Allocator) void {
    var n = 0
    // Literals and concatenation.
    check.t(io, a, &n, "abc", "xabcx")
    check.t(io, a, &n, "abc", "ab")
    check.t(io, a, &n, "", "")
    check.t(io, a, &n, "", "abc")
    check.t(io, a, &n, "a", "aaa")
    check.t(io, a, &n, "héllo", "say héllo")
    check.t(io, a, &n, "日本", "こんにちは日本語")
    // Alternation: the first alternative that matches wins.
    check.t(io, a, &n, "a|ab", "ab")
    check.t(io, a, &n, "ab|a", "ab")
    check.t(io, a, &n, "cat|dog|bird", "a dog and a bird")
    check.t(io, a, &n, "a|", "b")
    check.t(io, a, &n, "|a", "a")
    check.t(io, a, &n, "x(a|b|)y", "xy xay xby xcy")
    // Repetition, greedy and lazy.
    check.t(io, a, &n, "a*", "aaab")
    check.t(io, a, &n, "a*?", "aaab")
    check.t(io, a, &n, "a+", "baaab")
    check.t(io, a, &n, "a+?", "baaab")
    check.t(io, a, &n, "a?", "ab")
    check.t(io, a, &n, "a??b", "ab")
    check.t(io, a, &n, "a{2}", "aaaaa")
    check.t(io, a, &n, "a{2,}", "aaaaa")
    check.t(io, a, &n, "a{2,3}", "aaaaa")
    check.t(io, a, &n, "a{2,3}?", "aaaaa")
    check.t(io, a, &n, "a{0}b", "ab")
    check.t(io, a, &n, "a{0,1}b", "aab")
    check.t(io, a, &n, "(ab){2}", "abababab")
    check.t(io, a, &n, "a{,2}", "a{,2}")
    check.t(io, a, &n, "a{x}", "a{x}")
    check.t(io, a, &n, "a{", "a{")
    check.t(io, a, &n, "x{1}{", "x{")
    check.t(io, a, &n, "<.*>", "<a><b>")
    check.t(io, a, &n, "<.*?>", "<a><b>")
    check.t(io, a, &n, "(?U)<.*>", "<a><b>")
    check.t(io, a, &n, "(?U)<.*?>", "<a><b>")
    check.t(io, a, &n, "(a*)*", "b")
    check.t(io, a, &n, "(a*)+", "b")
    check.t(io, a, &n, "(a|b)*c", "abbac")
    check.t(io, a, &n, "(a+|b+)*", "aabba")
    check.t(io, a, &n, "(a*)*b", "aaab")
    check.t(io, a, &n, "(?:a*)*", "aa")
    check.t(io, a, &n, "(a?)*?b", "aab")
    check.t(io, a, &n, "x*y*z*", "xxyyzz")
    // Groups and captures.
    check.t(io, a, &n, "(a)(b)(c)", "abc")
    check.t(io, a, &n, "(a)|(b)", "b")
    check.t(io, a, &n, "(a(b(c)))", "abc")
    check.t(io, a, &n, "(a)?b", "b")
    check.t(io, a, &n, "(a)*", "aaa")
    check.t(io, a, &n, "(a|ab)(c|bcd)(d*)", "abcd")
    check.t(io, a, &n, "(?:ab)+", "ababx")
    check.t(io, a, &n, "(?P<year>\\d{4})-(?P<month>\\d{2})", "on 2026-11-27")
    check.t(io, a, &n, "(?<word>\\w+)", "  hi")
    check.t(io, a, &n, "()", "x")
    check.t(io, a, &n, "(|a)+", "aa")
    check.t(io, a, &n, "(a|b)*?c", "abc")
    // Classes.
    check.t(io, a, &n, "[abc]+", "xxbcaxx")
    check.t(io, a, &n, "[^abc]+", "abxyzc")
    check.t(io, a, &n, "[a-z]+", "ABcdeFG")
    check.t(io, a, &n, "[a-cx-z]+", "abxyzmn")
    check.t(io, a, &n, "[]a]+", "a]b")
    check.t(io, a, &n, "[^]a]+", "a]bc")
    check.t(io, a, &n, "[a-]+", "a-b")
    check.t(io, a, &n, "[-a]+", "-ab")
    check.t(io, a, &n, "[\\]]", "]")
    check.t(io, a, &n, "[\\-]", "-")
    check.t(io, a, &n, "[\\d.]+", "v1.25x")
    check.t(io, a, &n, "[^\\d]+", "12ab34")
    check.t(io, a, &n, "[\\w-]+", "a-b_c d")
    check.t(io, a, &n, "[\\s]+", "a \t\nb")
    check.t(io, a, &n, "[\\S]+", "  ab ")
    check.t(io, a, &n, "[à-ÿ]+", "voilà é")
    check.t(io, a, &n, "[^a]", "日")
    check.t(io, a, &n, "[[:alpha:]]+", "12abC3")
    check.t(io, a, &n, "[[:^alpha:]]+", "ab12c")
    check.t(io, a, &n, "[[:digit:][:upper:]]+", "abC12Dx")
    check.t(io, a, &n, "[[:punct:]]+", "a!?.b")
    check.t(io, a, &n, "[[:space:]]+", "a \t\x0bb")
    check.t(io, a, &n, "[[:xdigit:]]+", "xyzBEEFz")
    check.t(io, a, &n, "[[:word:]]+", "  a_1-")
    check.t(io, a, &n, "[[:alpha:]-z]+", "ab-z")
    check.t(io, a, &n, "[[a]+", "[a")
    check.t(io, a, &n, "[x[:]+", "x[:")
    // Perl classes.
    check.t(io, a, &n, "\\d+", "abc123def")
    check.t(io, a, &n, "\\D+", "123abc456")
    check.t(io, a, &n, "\\w+", "  foo_bar9!")
    check.t(io, a, &n, "\\W+", "ab  !cd")
    check.t(io, a, &n, "\\s+", "a \t b")
    check.t(io, a, &n, "\\S+", "  ab  ")
    check.t(io, a, &n, "\\d", "٣")
    // Dot.
    check.t(io, a, &n, "a.c", "abc a\nc")
    check.t(io, a, &n, "(?s)a.c", "a\nc")
    check.t(io, a, &n, ".", "日本")
    check.t(io, a, &n, ".+", "ab\ncd")
    check.t(io, a, &n, "(?s).+", "ab\ncd")
    // Anchors.
    check.t(io, a, &n, "^abc", "abc")
    check.t(io, a, &n, "^abc", "xabc")
    check.t(io, a, &n, "abc$", "xabc")
    check.t(io, a, &n, "abc$", "abc\n")
    check.t(io, a, &n, "^$", "")
    check.t(io, a, &n, "^$", "x")
    check.t(io, a, &n, "^", "ab")
    check.t(io, a, &n, "$", "ab")
    check.t(io, a, &n, "(?m)^\\w+", "one\ntwo\nthree")
    check.t(io, a, &n, "(?m)\\w+$", "one\ntwo\nthree")
    check.t(io, a, &n, "(?m)^$", "a\n\nb\n")
    check.t(io, a, &n, "(?m)^", "a\nb")
    check.t(io, a, &n, "\\Aab", "abab")
    check.t(io, a, &n, "ab\\z", "abab")
    check.t(io, a, &n, "(?m)\\Aa", "b\na")
    check.t(io, a, &n, "a^b", "a^b")
    check.t(io, a, &n, "x*$", "xx\nxx")
    check.t(io, a, &n, "(^a|b)+", "abab")
    // Word boundaries.
    check.t(io, a, &n, "\\bfoo\\b", "foo foobar barfoo foo")
    check.t(io, a, &n, "\\Bfoo", "foo barfoo")
    check.t(io, a, &n, "\\b", "ab cd")
    check.t(io, a, &n, "\\B", "ab cd")
    check.t(io, a, &n, "\\b", "")
    check.t(io, a, &n, "\\B", "")
    // An assertion in a loop: the DFA must not go round it twice.
    check.t(io, a, &n, "(?:\\b|b)*", "b")
    check.t(io, a, &n, "(\\b|b)*", "bb")
    // Flags.
    check.t(io, a, &n, "(?i)hello", "Say HeLLo")
    check.t(io, a, &n, "(?i)[a-c]+", "xAbCd")
    check.t(io, a, &n, "(?i)[^a]+", "AaBb")
    check.t(io, a, &n, "a(?i)b", "aB AB")
    check.t(io, a, &n, "(?i:a)b", "Ab AB")
    check.t(io, a, &n, "(?i)a(?-i)b", "AB Ab")
    check.t(io, a, &n, "(a(?i)b)c", "aBc aBC")
    check.t(io, a, &n, "x(?i)y|z", "xY Z")
    check.t(io, a, &n, "(?ms)^a.b$", "x\na\nb\ny")
    // Unicode classes and case folding, as Go's unicode package has them.
    check.t(io, a, &n, "\\pL+", "123 héllo Ωμέγα 日本 ")
    check.t(io, a, &n, "\\p{L}+", "--abc--")
    check.t(io, a, &n, "\\p{Lu}+", "abcDÉFghi")
    check.t(io, a, &n, "\\p{Ll}", "ABCdef")
    check.t(io, a, &n, "\\PL+", "abc 123 !? def")
    check.t(io, a, &n, "\\p{^L}+", "abc 123 !? def")
    check.t(io, a, &n, "\\P{^L}+", "123abc")
    check.t(io, a, &n, "\\pN+", "x ٣٤٥ 12 Ⅻ")
    check.t(io, a, &n, "\\p{Nd}+", "x ٣٤٥ 12 Ⅻ")
    check.t(io, a, &n, "\\p{Greek}+", "alpha αβγ Ωμέγα omega")
    check.t(io, a, &n, "\\p{Han}+", "kanji 日本語 kana かな")
    check.t(io, a, &n, "\\p{Hiragana}+", "kanji 日本語 kana かな")
    check.t(io, a, &n, "\\p{Cyrillic}+\\s\\p{Cyrillic}+", "Hello Привет мир")
    check.t(io, a, &n, "[\\p{Greek}\\d]+", "x12αβ3y")
    check.t(io, a, &n, "[^\\p{L}\\s]+", "ab 12! cd")
    check.t(io, a, &n, "[\\P{L}a]+", "bca1!a2b")
    check.t(io, a, &n, "\\p{Any}+", "a日\n")
    check.t(io, a, &n, "\\p{Zs}", "a\u{3000}b c")
    check.t(io, a, &n, "\\p{Sc}+", "costs $5 or €4 or ¥3")
    check.t(io, a, &n, "\\p{P}+", "hi, there!?")
    check.t(io, a, &n, "\\p{Emoji}", "x")
    check.t(io, a, &n, "(?i)k", "\u{212a}")
    check.t(io, a, &n, "(?i)\\x{212a}", "k K")
    check.t(io, a, &n, "(?i)s", "\u{17f}")
    check.t(io, a, &n, "(?i)é", "É é")
    check.t(io, a, &n, "(?i)σ+", "ΣσςΣ")
    check.t(io, a, &n, "(?i)ß", "ẞ ß ss")
    check.t(io, a, &n, "(?i)стоп", "СТОП")
    check.t(io, a, &n, "(?i)[а-я]+", "ПРИВЕТ мир")
    check.t(io, a, &n, "(?i)[^k]", "\u{212a}")
    check.t(io, a, &n, "(?i)\\w+", "a\u{212a}\u{17f}b")
    check.t(io, a, &n, "(?i)\\W", "\u{212a}\u{17f}!")
    check.t(io, a, &n, "(?i)[\\W]", "\u{212a}!")
    check.t(io, a, &n, "(?i)[[:upper:]]+", "abc\u{212a}DEF")
    check.t(io, a, &n, "(?i)[[:^lower:]]+", "abc\u{212a}DEF1")
    check.t(io, a, &n, "(?i)\\p{Lu}+", "abcDEF")
    check.t(io, a, &n, "(?i)\\P{Lu}+", "abcDEF")
    check.t(io, a, &n, "(?i)\\p{Greek}+", "ΑΒΓαβγ")
    check.t(io, a, &n, "(?i)[a-c]+", "ABC")
    check.t(io, a, &n, "(?i)ǅ", "Ǆ ǆ ǅ")
    // A backslash in the text, then u{41}: not an escape (test/go).
    check.t(io, a, &n, "u", "\\u{41}")
    // Escapes.
    check.t(io, a, &n, "\\.\\*\\+\\?\\(\\)\\[\\]\\{\\}\\|\\^\\$\\\\", ".*+?()[]{}|^$\\")
    check.t(io, a, &n, "\\x41\\x{42}\\x{65e5}", "ABC AB日")
    check.t(io, a, &n, "\\t\\n", "a\t\nb")
    check.t(io, a, &n, "a\\-b", "a-b")
    check.t(io, a, &n, "\\#\\ ", "# ")
    // \Q...\E and octal escapes.
    check.t(io, a, &n, "\\Qa.b*c\\E", "a.b*c abbbc")
    check.t(io, a, &n, "x\\Q(+)\\Ey", "x(+)y")
    check.t(io, a, &n, "\\Qab\\E+", "abbb")
    check.t(io, a, &n, "\\Q1+1=2", "is 1+1=2")
    check.t(io, a, &n, "\\Q\\E", "x")
    check.t(io, a, &n, "a\\Q\\Eb", "ab")
    check.t(io, a, &n, "\\Q\\\\E", "\\")
    check.t(io, a, &n, "\\Q[\\d]\\E", "[\\d]")
    check.t(io, a, &n, "(?i)\\QAbc\\E", "aBC")
    check.t(io, a, &n, "\\Qé日\\E", "é日")
    check.t(io, a, &n, "\\Qa|b\\E|c", "c a|b")
    check.t(io, a, &n, "\\101\\102", "AB")
    check.t(io, a, &n, "\\0", "a\x00b")
    check.t(io, a, &n, "\\012", "a\nb")
    check.t(io, a, &n, "\\0123", "\n3")
    check.t(io, a, &n, "\\12", "\n")
    check.t(io, a, &n, "\\1234", "S4")
    check.t(io, a, &n, "\\777", "\u{1ff}")
    check.t(io, a, &n, "[\\060-\\071]+", "x123y")
    check.t(io, a, &n, "\\1", "")
    check.t(io, a, &n, "\\18", "")
    check.t(io, a, &n, "\\8", "")
    check.t(io, a, &n, "\\E", "")
    check.t(io, a, &n, "[\\Q]\\E]", "")
    check.t(io, a, &n, "\\Q\\E*", "")
    // Invalid UTF-8 in the text is U+FFFD to . and classes.
    check.t(io, a, &n, ".", "\xff")
    check.t(io, a, &n, "a.b", "a\xffb")
    check.t(io, a, &n, "[^x]+", "\xff\xfe")
    check.t(io, a, &n, "\\x{fffd}", "\xff")
    check.t(io, a, &n, "a+", "\xffaa\xff")
    // Leftmost, then the pattern's preference.
    check.t(io, a, &n, "b|abc", "abc")
    check.t(io, a, &n, "(a|b)(c|d)|ab", "abd")
    check.t(io, a, &n, "a*b*", "xaabb")
    check.t(io, a, &n, "foo|foobar", "foobar")
    check.t(io, a, &n, "(foo|foobar)$", "foobar")
    // Larger.
    check.t(io, a, &n, "(\\w+)@(\\w+)\\.com", "mail bob@example.com, eve@corp.com")
    check.t(io, a, &n, "(\\d+)\\.(\\d+)\\.(\\d+)", "version 10.24.3-beta")
    check.t(io, a, &n, "^(GET|POST) (/\\S*) HTTP/1\\.[01]$", "GET /index.html HTTP/1.1")
    check.t(io, a, &n, "(?i)\\b(err(or)?|warn(ing)?)\\b", "an Error, a WARN, no warns")
    check.t(io, a, &n, "\"([^\"\\\\]|\\\\.)*\"", "say \"a\\\"b\" ok")
    check.t(io, a, &n, "(a|aa)*b", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaab")
    check.t(io, a, &n, "(x+x+)+y", "xxxxxxxxxxxxxxxxxxxxxxxxx")
    check.t(io, a, &n, "[a-z]{3,5}[0-9]{2}", "ab12 abcd123 abcdef45")
    // Not patterns.
    check.t(io, a, &n, "(", "")
    check.t(io, a, &n, ")", "")
    check.t(io, a, &n, "a)", "")
    check.t(io, a, &n, "[a", "")
    check.t(io, a, &n, "[]", "")
    check.t(io, a, &n, "[z-a]", "")
    check.t(io, a, &n, "*", "")
    check.t(io, a, &n, "a**", "")
    check.t(io, a, &n, "a{2}{3}", "")
    check.t(io, a, &n, "a{1001}", "")
    check.t(io, a, &n, "a{3,2}", "")
    check.t(io, a, &n, "\\", "")
    check.t(io, a, &n, "\\q", "")
    check.t(io, a, &n, "\\1", "")
    check.t(io, a, &n, "(?=a)", "")
    check.t(io, a, &n, "(?<=a)", "")
    check.t(io, a, &n, "(?x)a", "")
    check.t(io, a, &n, "(?)", "")
    check.t(io, a, &n, "[[:foo:]]", "")
    check.t(io, a, &n, "\\x{110000}", "")
    check.t(io, a, &n, "\\xg0", "")
    check.t(io, a, &n, "a|*", "")
    check.t(io, a, &n, "(*)", "")
    check.t(io, a, &n, "\\p{Nope}", "")
    check.t(io, a, &n, "\\p", "")
    check.t(io, a, &n, "\\p{L", "")
    check.t(io, a, &n, "[\\p{Nope}]", "")
}
