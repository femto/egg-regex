// The parser of regex: a pattern to a tree of nodes, kept flat in
// buffers, where a node names its children by index. The syntax is
// RE2's, without what needs backtracking (back-references, lookaround);
// README has it. An error is an error.Name, and `at` is left at the byte
// offset where the pattern goes wrong.
uses alloc

const unicode = @import("unicode.egg")

// The largest count in {n,m}, as RE2 has it.
const MAX_REPEAT = 1000
// How deep groups may nest, so that parsing and compiling, which recur
// on the tree, stay well inside the stack.
const MAX_DEPTH = 1000
// The largest code point.
const MAX_CP = 1114111

const Kind = enum { empty, lit, cls, any, any_nl, begin_line, end_line, begin_text, end_text, word, not_word, cat, alt, rep, group }

// lit: a is the code point. cls: ranges[a..a + b]. cat, alt: kids[a..a +
// b]. rep: a is the node repeated, b..c the counts (c is -1 for no
// limit), greedy whether it takes as many as it can first, counted
// whether it was written {n,m} (not *, + or ?). group: a is the node
// inside, b the group's number.
const Node = struct {
    kind: Kind
    a: i64
    b: i64
    c: i64
    greedy: bool
    counted: bool
}

// Code points lo to hi, both included.
const Range = struct {
    lo: i64
    hi: i64
}

// A named group: its name is names[at..at + len].
const Group = struct {
    at: i64
    len: i64
    index: i64
}

const Ast = struct {
    nodes: Buf(Node)
    kids: Buf(i64)
    ranges: Buf(Range)
    names: Buf(u8)
    groups: Buf(Group)
    // Groups, counting the whole match as group 0.
    ncap: i64
    root: i64
}

// (?i) case-insensitive (ASCII letters), (?m) ^ and $ at lines, (?s) .
// matches \n too, (?U) repetitions lazy unless marked ? (and the other way
// round).
const Flags = struct {
    fold: bool
    multi: bool
    dot_nl: bool
    lazy: bool
}

// A code point decoded from UTF-8, and its length in bytes. A byte that
// does not start valid UTF-8 is U+FFFD of length 1, and ok is false.
const Rune = struct {
    cp: i64
    len: i64
    ok: bool
}

fn decode(s: []u8, i: i64) Rune {
    const b0 = @as(i64, s[i])
    if (b0 < 128) {
        return Rune{ .cp = b0, .len = 1, .ok = true }
    }
    const bad = Rune{ .cp = 65533, .len = 1, .ok = false }
    var n = 0
    var cp = 0
    var min = 0
    if (b0 >= 194 and b0 <= 223) {
        n = 1
        cp = b0 & 31
        min = 128
    } else if (b0 >= 224 and b0 <= 239) {
        n = 2
        cp = b0 & 15
        min = 2048
    } else if (b0 >= 240 and b0 <= 244) {
        n = 3
        cp = b0 & 7
        min = 65536
    } else {
        return bad
    }
    if (i + n >= @len(s)) {
        return bad
    }
    var k = 1
    while (k <= n) {
        const b = @as(i64, s[i + k])
        if ((b & 192) != 128) {
            return bad
        }
        cp = (cp << 6) | (b & 63)
        k = k + 1
    }
    if (cp < min or cp > MAX_CP or (cp >= 55296 and cp <= 57343)) {
        return bad
    }
    return Rune{ .cp = cp, .len = n + 1, .ok = true }
}

fn parse(a: Allocator, s: []u8, inout at: i64) !Ast {
    var t = Ast{ .nodes = .empty, .kids = .empty, .ranges = .empty, .names = .empty, .groups = .empty, .ncap = 1, .root = 0 }
    errdefer a.free(t)
    var flags = Flags{ .fold = false, .multi = false, .dot_nl = false, .lazy = false }
    at = 0
    t.root = try alt(a, s, &t, &at, &flags, 0)
    if (at < @len(s)) {
        // alt stops only at the end or at a ')' no '(' opened.
        return error.UnopenedParen
    }
    return t
}

fn add(a: Allocator, inout t: Ast, kind: Kind, x: i64, y: i64) i64 {
    a.push(&t.nodes, Node{ .kind = kind, .a = x, .b = y, .c = 0, .greedy = true, .counted = false })
    return @len(t.nodes) - 1
}

// A cat or an alt of items, or the one item alone.
fn list(a: Allocator, inout t: Ast, kind: Kind, items: Buf(i64)) i64 {
    if (@len(items) == 1) {
        return items[0]
    }
    const start = @len(t.kids)
    for (items) |n| {
        a.push(&t.kids, n)
    }
    return add(a, &t, kind, start, @len(items))
}

// Alternatives, up to the end or a ')'.
fn alt(a: Allocator, s: []u8, inout t: Ast, inout at: i64, inout flags: Flags, depth: i64) !i64 {
    if (depth > MAX_DEPTH) {
        return error.TooDeep
    }
    var items: Buf(i64) = .empty
    defer a.free(items)
    const first = try concat(a, s, &t, &at, &flags, depth)
    a.push(&items, first)
    while (at < @len(s) and s[at] == '|') {
        at = at + 1
        const next = try concat(a, s, &t, &at, &flags, depth)
        a.push(&items, next)
    }
    return list(a, &t, .alt, items)
}

// What one alternative is: a run of items, each maybe repeated.
fn concat(a: Allocator, s: []u8, inout t: Ast, inout at: i64, inout flags: Flags, depth: i64) !i64 {
    var items: Buf(i64) = .empty
    defer a.free(items)
    // Whether the last item came from a repetition, which may not be
    // repeated again (a**); a group around it may ((a*)*).
    var repeated = false
    while (at < @len(s) and s[at] != '|' and s[at] != ')') {
        const c = s[at]
        var min = -1
        var max = -1
        var end = at + 1
        if (c == '*') {
            min = 0
        } else if (c == '+') {
            min = 1
        } else if (c == '?') {
            min = 0
            max = 1
        } else if (c == '{') {
            if (braces(s, at)) |r| {
                min = r.lo
                max = r.hi
                end = r.end
            }
        }
        if (min < 0 and c == '\\' and at + 1 < @len(s) and s[at + 1] == 'Q') {
            // \Q...\E: every character up to \E (or the end) a literal of
            // its own, so that a repetition after it repeats the last.
            at = at + 2
            while (at < @len(s) and !(s[at] == '\\' and at + 1 < @len(s) and s[at + 1] == 'E')) {
                const r = decode(s, at)
                if (!r.ok) {
                    return error.BadUtf8
                }
                a.push(&items, literal(a, &t, r.cp, flags))
                at = at + r.len
            }
            if (at < @len(s)) {
                at = at + 2
            }
            repeated = false
            continue
        }
        if (min < 0) {
            const item = try atom(a, s, &t, &at, &flags, depth)
            if (item >= 0) {
                a.push(&items, item)
                repeated = false
            }
            continue
        }
        if (@len(items) == 0) {
            return error.NothingToRepeat
        }
        if (repeated) {
            return error.NestedRepeat
        }
        if (min > MAX_REPEAT or max > MAX_REPEAT) {
            return error.RepeatTooBig
        }
        if (max >= 0 and max < min) {
            return error.BadRepeat
        }
        var greedy = !flags.lazy
        if (end < @len(s) and s[end] == '?') {
            greedy = !greedy
            end = end + 1
        }
        const last = @len(items) - 1
        const counted = c == '{'
        a.push(&t.nodes, Node{ .kind = .rep, .a = items[last], .b = min, .c = max, .greedy = greedy, .counted = counted })
        items[last] = @len(t.nodes) - 1
        // As Go: counted repetitions inside one another may not go past
        // MAX_REPEAT along any path ((a{2}){501} is too many, though
        // (a{10}b{10}){51} is not).
        if (counted and (min >= 2 or max >= 2) and !repeats_fit(t, items[last], MAX_REPEAT)) {
            return error.RepeatTooBig
        }
        repeated = true
        at = end
    }
    if (@len(items) == 0) {
        return add(a, &t, .empty, 0, 0)
    }
    return list(a, &t, .cat, items)
}

// Whether the counted repetitions in node n, each taking its largest
// count (or its smallest, with no largest) from what the ones around it
// leave of limit, fit, as Go's repeatIsValid has it. A {0} holds
// nothing; *, + and ? count for nothing.
fn repeats_fit(t: Ast, n: i64, limit: i64) bool {
    const node = t.nodes[n]
    var left = limit
    if (node.kind == .rep and node.counted) {
        var m = node.c
        if (m == 0) {
            return true
        }
        if (m < 0) {
            m = node.b
        }
        if (m > left) {
            return false
        }
        if (m > 0) {
            left = left / m
        }
    }
    if (node.kind == .rep or node.kind == .group) {
        return repeats_fit(t, node.a, left)
    }
    if (node.kind == .cat or node.kind == .alt) {
        var i = 0
        while (i < node.b) {
            if (!repeats_fit(t, t.kids[node.a + i], left)) {
                return false
            }
            i = i + 1
        }
    }
    return true
}

// {n}, {n,} or {n,m} at s[at]: the counts (hi -1 for none) and where it
// ends; null if it is not one, and then the '{' is itself (as in RE2).
fn braces(s: []u8, at: i64) ?Brace {
    var i = at + 1
    const lo = number(s, &i) orelse return null
    var hi = lo
    if (i < @len(s) and s[i] == ',') {
        i = i + 1
        hi = -1
        if (i < @len(s) and s[i] != '}') {
            hi = number(s, &i) orelse return null
        }
    }
    if (i >= @len(s) or s[i] != '}') {
        return null
    }
    return Brace{ .lo = lo, .hi = hi, .end = i + 1 }
}

const Brace = struct {
    lo: i64
    hi: i64
    end: i64
}

// Decimal digits at s[i], moving i past them; null if there are none.
// Values past MAX_REPEAT stop growing, which is enough to reject them.
fn number(s: []u8, inout i: i64) ?i64 {
    const start = i
    var n = 0
    while (i < @len(s) and s[i] >= '0' and s[i] <= '9') {
        if (n <= MAX_REPEAT) {
            n = n * 10 + @as(i64, s[i] - '0')
        }
        i = i + 1
    }
    if (i == start) {
        return null
    }
    return n
}

// One item: its node, or -1 for a group of flags only, (?i), which
// changes flags and matches nothing.
fn atom(a: Allocator, s: []u8, inout t: Ast, inout at: i64, inout flags: Flags, depth: i64) !i64 {
    const c = s[at]
    if (c == '(') {
        return group(a, s, &t, &at, &flags, depth)
    }
    if (c == '[') {
        return class(a, s, &t, &at, flags)
    }
    if (c == '.') {
        at = at + 1
        return add(a, &t, if (flags.dot_nl) .any_nl else .any, 0, 0)
    }
    if (c == '^') {
        at = at + 1
        return add(a, &t, if (flags.multi) .begin_line else .begin_text, 0, 0)
    }
    if (c == '$') {
        at = at + 1
        return add(a, &t, if (flags.multi) .end_line else .end_text, 0, 0)
    }
    if (c == '\\') {
        return escape(a, s, &t, &at, flags)
    }
    const r = decode(s, at)
    if (!r.ok) {
        return error.BadUtf8
    }
    at = at + r.len
    return literal(a, &t, r.cp, flags)
}

// The code point cp, or under (?i) every code point that folds to it
// (k: k, K and U+212A, the Kelvin sign).
fn literal(a: Allocator, inout t: Ast, cp: i64, flags: Flags) i64 {
    if (flags.fold) {
        var rs: Buf(Range) = .empty
        defer a.free(rs)
        a.push(&rs, Range{ .lo = cp, .hi = cp })
        fold(a, &rs)
        if (@len(rs) > 1 or rs[0].lo != rs[0].hi) {
            return ranges_node(a, &t, &rs, false, false)
        }
    }
    return add(a, &t, .lit, cp, 0)
}

fn is_letter(cp: i64) bool {
    return (cp >= 'A' and cp <= 'Z') or (cp >= 'a' and cp <= 'z')
}

// (re), (?:re), (?P<name>re), (?<name>re), (?flags) and (?flags:re);
// -1 for (?flags).
fn group(a: Allocator, s: []u8, inout t: Ast, inout at: i64, inout flags: Flags, depth: i64) !i64 {
    const open = at
    at = at + 1
    var index = -1
    var inner = flags
    if (at < @len(s) and s[at] == '?') {
        at = at + 1
        if (at + 1 < @len(s) and s[at] == '<' and (s[at + 1] == '=' or s[at + 1] == '!')) {
            // Lookbehind.
            return error.BadGroup
        }
        if (at < @len(s) and (s[at] == '<' or (s[at] == 'P' and at + 1 < @len(s) and s[at + 1] == '<'))) {
            at = at + (if (s[at] == 'P') 2 else 1)
            const name_start = at
            while (at < @len(s) and is_name_byte(s[at])) {
                at = at + 1
            }
            if (at >= @len(s) or s[at] != '>' or at == name_start or (s[name_start] >= '0' and s[name_start] <= '9')) {
                at = open
                return error.BadGroupName
            }
            const name = s[name_start..at]
            for (t.groups) |g| {
                if (t.names[g.at..g.at + g.len] == name) {
                    at = open
                    return error.DuplicateGroupName
                }
            }
            index = t.ncap
            a.push(&t.groups, Group{ .at = @len(t.names), .len = @len(name), .index = index })
            a.append_str(&t.names, name)
            t.ncap = t.ncap + 1
            at = at + 1
        } else {
            // Flags, then ')' (for the rest of the enclosing group) or ':'
            // (for this group only).
            var on = true
            while (at < @len(s) and s[at] != ')' and s[at] != ':') {
                const f = s[at]
                if (f == '-' and on) {
                    on = false
                } else if (f == 'i') {
                    inner.fold = on
                } else if (f == 'm') {
                    inner.multi = on
                } else if (f == 's') {
                    inner.dot_nl = on
                } else if (f == 'U') {
                    inner.lazy = on
                } else if (is_letter(@as(i64, f))) {
                    return error.BadFlags
                } else {
                    // Lookahead ((?=, (?!), atomic groups and the like.
                    return error.BadGroup
                }
                at = at + 1
            }
            if (at >= @len(s)) {
                at = open
                return error.MissingParen
            }
            if (!on and s[at - 1] == '-') {
                return error.BadFlags
            }
            if (s[at] == ')') {
                // Flags for the rest of the group, and no item (-1).
                flags = inner
                at = at + 1
                return -1
            }
            at = at + 1
        }
    } else {
        index = t.ncap
        t.ncap = t.ncap + 1
    }
    const body = try alt(a, s, &t, &at, &inner, depth + 1)
    if (at >= @len(s)) {
        at = open
        return error.MissingParen
    }
    at = at + 1
    if (index < 0) {
        return body
    }
    return add(a, &t, .group, body, index)
}

fn is_name_byte(c: u8) bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
}

// A backslash outside a class.
fn escape(a: Allocator, s: []u8, inout t: Ast, inout at: i64, flags: Flags) !i64 {
    if (at + 1 >= @len(s)) {
        return error.TrailingBackslash
    }
    const c = s[at + 1]
    if (c == 'd' or c == 'D' or c == 'w' or c == 'W' or c == 's' or c == 'S') {
        var rs: Buf(Range) = .empty
        defer a.free(rs)
        perl(a, &rs, c, flags.fold)
        at = at + 2
        return ranges_node(a, &t, &rs, false, false)
    }
    if (c == 'p' or c == 'P') {
        var rs: Buf(Range) = .empty
        defer a.free(rs)
        try property(a, s, &at, &rs, flags.fold)
        return ranges_node(a, &t, &rs, false, false)
    }
    var look = Kind.empty
    if (c == 'b') {
        look = .word
    } else if (c == 'B') {
        look = .not_word
    } else if (c == 'A') {
        look = .begin_text
    } else if (c == 'z') {
        look = .end_text
    }
    if (look != .empty) {
        at = at + 2
        return add(a, &t, look, 0, 0)
    }
    const cp = try escape_char(s, &at)
    return literal(a, &t, cp, flags)
}

// The code point a backslash at s[at] stands for, moving at past it:
// \n \t \r \f \v \a, \xHH, \x{H...}, octal (\0 and up to two more digits,
// or \1 to \7 and one or two more: \1 alone would be a back-reference),
// and any other ASCII byte but a letter or digit as itself (as in RE2 and
// Go: \. \_ \ ).
fn escape_char(s: []u8, inout at: i64) !i64 {
    if (at + 1 >= @len(s)) {
        return error.TrailingBackslash
    }
    const c = s[at + 1]
    at = at + 2
    if (c == 'n') {
        return 10
    } else if (c == 't') {
        return 9
    } else if (c == 'r') {
        return 13
    } else if (c == 'f') {
        return 12
    } else if (c == 'v') {
        return 11
    } else if (c == 'a') {
        return 7
    } else if (c == 'x') {
        return hex_escape(s, &at)
    } else if (c >= '0' and c <= '7' and (c == '0' or (at < @len(s) and s[at] >= '0' and s[at] <= '7'))) {
        var n = @as(i64, c - '0')
        var k = 0
        while (k < 2 and at < @len(s) and s[at] >= '0' and s[at] <= '7') {
            n = n * 8 + @as(i64, s[at] - '0')
            at = at + 1
            k = k + 1
        }
        return n
    } else if (c < 128 and !is_letter(@as(i64, c)) and !(c >= '0' and c <= '9')) {
        return @as(i64, c)
    }
    at = at - 2
    return error.BadEscape
}

// After \x: two hex digits, or 1 or more in braces, up to U+10FFFF.
fn hex_escape(s: []u8, inout at: i64) !i64 {
    const start = at - 2
    var n = 0
    if (at < @len(s) and s[at] == '{') {
        at = at + 1
        var digits = 0
        while (at < @len(s) and s[at] != '}') {
            const d = hex(s[at])
            if (d < 0) {
                at = start
                return error.BadEscape
            }
            n = n * 16 + d
            if (n > MAX_CP) {
                at = start
                return error.BadEscape
            }
            digits = digits + 1
            at = at + 1
        }
        if (at >= @len(s) or digits == 0) {
            at = start
            return error.BadEscape
        }
        at = at + 1
        return n
    }
    var k = 0
    while (k < 2) {
        const d = if (at < @len(s)) hex(s[at]) else -1
        if (d < 0) {
            at = start
            return error.BadEscape
        }
        n = n * 16 + d
        at = at + 1
        k = k + 1
    }
    return n
}

fn hex(c: u8) i64 {
    if (c >= '0' and c <= '9') {
        return @as(i64, c - '0')
    }
    if (c >= 'a' and c <= 'f') {
        return @as(i64, c - 'a') + 10
    }
    if (c >= 'A' and c <= 'F') {
        return @as(i64, c - 'A') + 10
    }
    return -1
}

// \d \w \s and their negations \D \W \S, ASCII as in RE2. Under (?i)
// the set is folded before it is negated, as in Go: (?i)\w has U+212A,
// so (?i)\W does not.
fn perl(a: Allocator, inout rs: Buf(Range), c: u8, folding: bool) void {
    var set: Buf(Range) = .empty
    defer a.free(set)
    const lower = c | 32
    if (lower == 'd') {
        a.push(&set, Range{ .lo = '0', .hi = '9' })
    } else if (lower == 'w') {
        a.push(&set, Range{ .lo = '0', .hi = '9' })
        a.push(&set, Range{ .lo = 'A', .hi = 'Z' })
        a.push(&set, Range{ .lo = '_', .hi = '_' })
        a.push(&set, Range{ .lo = 'a', .hi = 'z' })
    } else {
        a.push(&set, Range{ .lo = 9, .hi = 10 })
        a.push(&set, Range{ .lo = 12, .hi = 13 })
        a.push(&set, Range{ .lo = 32, .hi = 32 })
    }
    if (folding) {
        fold(a, &set)
    }
    if (c != lower) {
        negate(a, &set)
    }
    for (set) |r| {
        a.push(&rs, r)
    }
}

// [...] and [^...].
fn class(a: Allocator, s: []u8, inout t: Ast, inout at: i64, flags: Flags) !i64 {
    const open = at
    at = at + 1
    var neg = false
    if (at < @len(s) and s[at] == '^') {
        neg = true
        at = at + 1
    }
    var rs: Buf(Range) = .empty
    defer a.free(rs)
    var first = true
    while (true) {
        if (at >= @len(s)) {
            at = open
            return error.MissingBracket
        }
        const c = s[at]
        if (c == ']' and !first) {
            at = at + 1
            break
        }
        first = false
        if (c == '[' and at + 1 < @len(s) and s[at + 1] == ':') {
            if (try posix(a, s, &at, &rs, flags.fold)) {
                continue
            }
        }
        if (c == '\\' and at + 1 < @len(s)) {
            const e = s[at + 1]
            if (e == 'd' or e == 'D' or e == 'w' or e == 'W' or e == 's' or e == 'S') {
                perl(a, &rs, e, flags.fold)
                at = at + 2
                continue
            }
            if (e == 'p' or e == 'P') {
                try property(a, s, &at, &rs, flags.fold)
                continue
            }
        }
        const lo = try class_char(s, &at)
        var hi = lo
        if (at + 1 < @len(s) and s[at] == '-' and s[at + 1] != ']') {
            const dash = at
            at = at + 1
            hi = try class_char(s, &at)
            if (hi < lo) {
                at = dash - 1
                return error.BadRange
            }
        }
        a.push(&rs, Range{ .lo = lo, .hi = hi })
    }
    return ranges_node(a, &t, &rs, flags.fold, neg)
}

// \pN, \p{Name}, \p{^Name} and \PN, \P{Name}: a general category or a
// script as Go's unicode package has them ("L", "Lu", "Greek"), or Any,
// added to rs; under (?i) folded before it is negated, as in Go.
fn property(a: Allocator, s: []u8, inout at: i64, inout rs: Buf(Range), folding: bool) !void {
    const start = at
    var neg = s[at + 1] == 'P'
    var i = at + 2
    if (i >= @len(s)) {
        return error.BadProperty
    }
    var lo = i
    var hi = i + 1
    if (s[i] == '{') {
        lo = i + 1
        hi = lo
        while (hi < @len(s) and s[hi] != '}') {
            hi = hi + 1
        }
        if (hi >= @len(s)) {
            return error.BadProperty
        }
        i = hi + 1
        if (lo < hi and s[lo] == '^') {
            neg = !neg
            lo = lo + 1
        }
    } else {
        i = i + 1
    }
    const name = s[lo..hi]
    var set: Buf(Range) = .empty
    defer a.free(set)
    if (name == "Any") {
        a.push(&set, Range{ .lo = 0, .hi = MAX_CP })
    } else {
        const data = unicode.table(name) orelse {
            at = start
            return error.BadProperty
        }
        read_ranges(a, &set, data)
    }
    if (folding) {
        fold(a, &set)
    }
    if (neg) {
        negate(a, &set)
    }
    for (set) |r| {
        a.push(&rs, r)
    }
    at = i
}

// The value of a digit of unicode.egg's tables: its place in
// unicode.DIGITS.
fn digit(c: u8) i64 {
    if (c >= 'A' and c <= 'Z') {
        return @as(i64, c - 'A')
    }
    if (c >= 'a' and c <= 'z') {
        return @as(i64, c - 'a') + 26
    }
    if (c >= '0' and c <= '9') {
        return @as(i64, c - '0') + 52
    }
    return if (c == '+') 62 else 63
}

// The number at data[i], moving i past it (tools/unicode/main.go).
fn table_number(data: []u8, inout i: i64) i64 {
    var n = 0
    var d = digit(data[i])
    i = i + 1
    while (d >= 32) {
        n = n * 32 + d - 32
        d = digit(data[i])
        i = i + 1
    }
    return n * 32 + d
}

// The ranges of a table of unicode.egg, pushed onto rs.
fn read_ranges(a: Allocator, inout rs: Buf(Range), data: []u8) void {
    var i = 0
    var next = 0
    while (i < @len(data)) {
        const lo = next + table_number(data, &i)
        const hi = lo + table_number(data, &i)
        a.push(&rs, Range{ .lo = lo, .hi = hi })
        next = hi + 1
    }
}

// The smallest and largest code points simple case folding changes, as
// in Go: a set that does not reach between them folds to itself.
const MIN_FOLD = 65
const MAX_FOLD = 125251

// rs with every code point that folds to one in it (unicode.ORBITS), as
// Go's regexp folds under (?i). rs comes back sorted and merged.
fn fold(a: Allocator, inout rs: Buf(Range)) void {
    normalize(a, &rs)
    var reaches = false
    for (rs) |r| {
        if (r.hi >= MIN_FOLD and r.lo <= MAX_FOLD) {
            reaches = true
        }
    }
    if (!reaches) {
        return
    }
    var add_too: Buf(Range) = .empty
    defer a.free(add_too)
    const data = unicode.ORBITS
    var i = 0
    var first = 0
    while (i < @len(data)) {
        const n = table_number(data, &i)
        first = first + table_number(data, &i)
        // The members: first, then each as a gap from it; the orbit is
        // added if any is in rs.
        const at = i
        var hit = contains(rs, first)
        var k = 1
        while (k < n) {
            if (contains(rs, first + table_number(data, &i))) {
                hit = true
            }
            k = k + 1
        }
        if (hit) {
            var j = at
            a.push(&add_too, Range{ .lo = first, .hi = first })
            k = 1
            while (k < n) {
                const m = first + table_number(data, &j)
                a.push(&add_too, Range{ .lo = m, .hi = m })
                k = k + 1
            }
        }
    }
    for (add_too) |r| {
        a.push(&rs, r)
    }
    normalize(a, &rs)
}

// Whether cp is in the sorted, merged rs.
fn contains(rs: Buf(Range), cp: i64) bool {
    var lo = 0
    var hi = @len(rs)
    while (lo < hi) {
        const mid = lo + (hi - lo) / 2
        if (cp < rs[mid].lo) {
            hi = mid
        } else if (cp > rs[mid].hi) {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

// One character in a class: a code point, or an escape for one.
fn class_char(s: []u8, inout at: i64) !i64 {
    if (s[at] == '\\') {
        return escape_char(s, &at)
    }
    const r = decode(s, at)
    if (!r.ok) {
        return error.BadUtf8
    }
    at = at + r.len
    return r.cp
}

// [:name:] or [:^name:] at s[at], adding its ranges and moving at past it;
// false (at unmoved) if no ":]" closes it, so that it is a '[' and more.
fn posix(a: Allocator, s: []u8, inout at: i64, inout rs: Buf(Range), folding: bool) !bool {
    var i = at + 2
    var neg = false
    if (i < @len(s) and s[i] == '^') {
        neg = true
        i = i + 1
    }
    const start = i
    while (i < @len(s) and s[i] >= 'a' and s[i] <= 'z') {
        i = i + 1
    }
    if (i + 1 >= @len(s) or s[i] != ':' or s[i + 1] != ']') {
        return false
    }
    const name = s[start..i]
    var set: Buf(Range) = .empty
    defer a.free(set)
    if (name == "alnum") {
        a.push(&set, Range{ .lo = '0', .hi = '9' })
        a.push(&set, Range{ .lo = 'A', .hi = 'Z' })
        a.push(&set, Range{ .lo = 'a', .hi = 'z' })
    } else if (name == "alpha") {
        a.push(&set, Range{ .lo = 'A', .hi = 'Z' })
        a.push(&set, Range{ .lo = 'a', .hi = 'z' })
    } else if (name == "ascii") {
        a.push(&set, Range{ .lo = 0, .hi = 127 })
    } else if (name == "blank") {
        a.push(&set, Range{ .lo = 9, .hi = 9 })
        a.push(&set, Range{ .lo = 32, .hi = 32 })
    } else if (name == "cntrl") {
        a.push(&set, Range{ .lo = 0, .hi = 31 })
        a.push(&set, Range{ .lo = 127, .hi = 127 })
    } else if (name == "digit") {
        a.push(&set, Range{ .lo = '0', .hi = '9' })
    } else if (name == "graph") {
        a.push(&set, Range{ .lo = 33, .hi = 126 })
    } else if (name == "lower") {
        a.push(&set, Range{ .lo = 'a', .hi = 'z' })
    } else if (name == "print") {
        a.push(&set, Range{ .lo = 32, .hi = 126 })
    } else if (name == "punct") {
        a.push(&set, Range{ .lo = 33, .hi = 47 })
        a.push(&set, Range{ .lo = 58, .hi = 64 })
        a.push(&set, Range{ .lo = 91, .hi = 96 })
        a.push(&set, Range{ .lo = 123, .hi = 126 })
    } else if (name == "space") {
        a.push(&set, Range{ .lo = 9, .hi = 13 })
        a.push(&set, Range{ .lo = 32, .hi = 32 })
    } else if (name == "upper") {
        a.push(&set, Range{ .lo = 'A', .hi = 'Z' })
    } else if (name == "word") {
        a.push(&set, Range{ .lo = '0', .hi = '9' })
        a.push(&set, Range{ .lo = 'A', .hi = 'Z' })
        a.push(&set, Range{ .lo = '_', .hi = '_' })
        a.push(&set, Range{ .lo = 'a', .hi = 'z' })
    } else if (name == "xdigit") {
        a.push(&set, Range{ .lo = '0', .hi = '9' })
        a.push(&set, Range{ .lo = 'A', .hi = 'F' })
        a.push(&set, Range{ .lo = 'a', .hi = 'f' })
    } else {
        return error.BadClass
    }
    if (folding) {
        fold(a, &set)
    }
    if (neg) {
        negate(a, &set)
    }
    for (set) |r| {
        a.push(&rs, r)
    }
    at = i + 2
    return true
}

// A class node of rs: with (?i) every code point that folds to one in
// it too, sorted and merged, then negated if neg.
fn ranges_node(a: Allocator, inout t: Ast, inout rs: Buf(Range), folding: bool, neg: bool) i64 {
    if (folding) {
        fold(a, &rs)
    }
    normalize(a, &rs)
    if (neg) {
        negate(a, &rs)
    }
    const start = @len(t.ranges)
    for (rs) |r| {
        a.push(&t.ranges, r)
    }
    return add(a, &t, .cls, start, @len(rs))
}

// Sorted by lo, with ranges that overlap or touch made one.
fn normalize(a: Allocator, inout rs: Buf(Range)) void {
    var i = 1
    while (i < @len(rs)) {
        var j = i
        while (j > 0 and rs[j - 1].lo > rs[j].lo) {
            @swap(&rs, j - 1, j)
            j = j - 1
        }
        i = i + 1
    }
    var out: Buf(Range) = .empty
    for (rs) |r| {
        const n = @len(out)
        if (n > 0 and r.lo <= out[n - 1].hi + 1) {
            if (r.hi > out[n - 1].hi) {
                out[n - 1].hi = r.hi
            }
        } else {
            a.push(&out, r)
        }
    }
    const old = @replace(&rs, out)
    a.free(old)
}

// Every code point not in the sorted, merged rs.
fn negate(a: Allocator, inout rs: Buf(Range)) void {
    normalize(a, &rs)
    var out: Buf(Range) = .empty
    var next = 0
    for (rs) |r| {
        if (r.lo > next) {
            a.push(&out, Range{ .lo = next, .hi = r.lo - 1 })
        }
        next = r.hi + 1
    }
    if (next <= MAX_CP) {
        a.push(&out, Range{ .lo = next, .hi = MAX_CP })
    }
    const old = @replace(&rs, out)
    a.free(old)
}
