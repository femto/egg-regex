// The lazy DFA, for long texts: a state is the set of instructions the
// NFA's threads are at, in priority order, made the first time the
// search reaches it, with its transitions filled in as they are taken.
// It steps on classes of code points (prog.classes), not bytes, so the
// semantics are the NFA's to the letter. A forward DFA finds where the
// leftmost-first match ends; one over the program backwards
// (prog.compile_reverse) where it starts. Groups are then the NFA's
// work, on that span only (regex.run).
//
// Assertions look at the text on both sides of a position. Each state
// knows the side it has read (the kind of character before it, going
// forward, or after it, going back): an assertion that needs the other
// side waits in the state, and the transition, which knows the next
// character, settles it. That transition also says whether a match
// ended at the state it left, so a match is seen one character late, as
// in RE2.
uses alloc

const parse = @import("parse.egg")
const prog = @import("prog.egg")
const rx = @import("regex.egg")

// What is on one side of a position: the edge of the text, \n, an ASCII
// word character, or anything else.
const EDGE = 0
const NL = 1
const WORD = 2
const OTHER = 3

// The most words (8 bytes each) a DFA may take for its states, its
// transitions and its table: past this the search gives up, and the
// Pike VM runs instead.
const MAX_WORDS = 524288

// What a transition holds besides the state it goes to.
const UNKNOWN = -1
const DEAD = -2
const FINISH_MATCH = -3
const FINISH_NONE = -4
// Out of memory: the DFA gives up.
const FULL = -5

// A state's flags: threads still start at each position (no match yet,
// unanchored); bits 1-2 the kind of the side it has read; a match ended
// at the position before; and no thread is alive but the one that
// starts there, so a search may skip ahead.
const F_RESTART = 1
const F_MATCHED = 8
const F_ONLY = 16

// The states of one DFA. State i: meta[4i] where its instructions are in
// pcs, meta[4i + 1] how many, meta[4i + 2] its flags and meta[4i + 3]
// their hash; trans[i * width + col] where a column takes it, a column
// being a class of code points, or (from the number of classes on) the
// end of the search with the given kind on the other side.
const Dfa = struct {
    meta: Buf(i64)
    pcs: Buf(i64)
    trans: Buf(i64)
    // Open addressing on the hash: a state's number, or -1.
    table: Buf(i64)
    n: i64
    // The state a search starts at, for each kind on the side read.
    starts: [4]i64
    // MAX_WORDS, or less, to test what happens when it runs out.
    limit: i64
    full: bool
}

fn new_dfa() Dfa {
    return Dfa{ .meta = .empty, .pcs = .empty, .trans = .empty, .table = .empty, .n = 0, .starts = @splat(UNKNOWN), .limit = MAX_WORDS, .full = false }
}

// Room for closing sets of threads: seen[pc] == stamp for those already
// in, a stack, and three lists, each with how much of it is in use (a
// Buf's length changes only by reallocating, so these only grow).
const Work = struct {
    seen: Buf(i64)
    stamp: i64
    stack: Buf(i64)
    nstack: i64
    seeds: Buf(i64)
    nseeds: i64
    list: Buf(i64)
    nlist: i64
    next: Buf(i64)
    nnext: i64
}

// What a search needs besides the Regex: the NFA's memory (slots first),
// both DFAs and room for them to work. One may serve many searches of the
// same Regex: find_all and the like keep one for all their matches.
const Cache = struct {
    m: Buf(i64)
    fwd: Dfa
    rev: Dfa
    work: Work
}

fn new_cache() Cache {
    const w = Work{ .seen = .empty, .stamp = 0, .stack = .empty, .nstack = 0, .seeds = .empty, .nseeds = 0, .list = .empty, .nlist = 0, .next = .empty, .nnext = 0 }
    return Cache{ .m = .empty, .fwd = new_dfa(), .rev = new_dfa(), .work = w }
}

// b[n] = v, b growing by doubling.
fn put(a: Allocator, inout b: Buf(i64), inout n: i64, v: i64) void {
    if (n >= @len(b)) {
        const grown = if (@len(b) < 16) 16 else 2 * @len(b)
        a.resize(&b, grown, 0)
    }
    b[n] = v
    n = n + 1
}

fn kind(cp: i64) i64 {
    if (cp == 10) {
        return NL
    }
    if ((cp >= 'a' and cp <= 'z') or (cp >= 'A' and cp <= 'Z') or (cp >= '0' and cp <= '9') or cp == '_') {
        return WORD
    }
    return OTHER
}

// The kind of the character before pos, and after it: a byte is enough,
// \n and the word characters being ASCII.
fn kind_before(s: []u8, pos: i64) i64 {
    return if (pos == 0) EDGE else kind(@as(i64, s[pos - 1]))
}

fn kind_after(s: []u8, pos: i64) i64 {
    return if (pos == @len(s)) EDGE else kind(@as(i64, s[pos]))
}

// Whether the assertion op holds between a character of kind before and
// one of kind after.
fn holds(op: prog.Op, before: i64, after: i64) bool {
    switch (op) {
        .begin_text => {
            return before == EDGE
        }
        .begin_line => {
            return before == EDGE or before == NL
        }
        .end_text => {
            return after == EDGE
        }
        .end_line => {
            return after == EDGE or after == NL
        }
        .word => {
            return (before == WORD) != (after == WORD)
        }
        .not_word => {
            return (before == WORD) == (after == WORD)
        }
        else => {
            return true
        }
    }
}

// Whether op needs the side before a position, and the side after.
fn needs_before(op: prog.Op) bool {
    return op == .begin_text or op == .begin_line or op == .word or op == .not_word
}

fn needs_after(op: prog.Op) bool {
    return op == .end_text or op == .end_line or op == .word or op == .not_word
}

// w.list gets, in priority order, the instructions w.seeds lead to
// without consuming: those that consume, match, and assertions that need
// the side not known yet (ahead is -1 when it is not). known is the kind
// of the side read: before the position going forward, after it going
// back. As regex.add does, without the slots.
fn close(a: Allocator, insts: Buf(prog.Inst), inout w: Work, forward: bool, known: i64, ahead: i64) void {
    if (@len(w.seen) < @len(insts)) {
        a.resize(&w.seen, @len(insts), 0)
    }
    w.stamp = w.stamp + 1
    w.nlist = 0
    const before = if (forward) known else ahead
    const after = if (forward) ahead else known
    var i = 0
    while (i < w.nseeds) {
        w.nstack = 0
        put(a, &w.stack, &w.nstack, w.seeds[i])
        while (w.nstack > 0) {
            w.nstack = w.nstack - 1
            var pc = w.stack[w.nstack]
            while (w.seen[pc] != w.stamp) {
                w.seen[pc] = w.stamp
                const ins = insts[pc]
                if (ins.op == .jmp) {
                    pc = ins.x
                } else if (ins.op == .split) {
                    put(a, &w.stack, &w.nstack, ins.y)
                    pc = ins.x
                } else if (ins.op == .save) {
                    pc = pc + 1
                } else if (needs_before(ins.op) or needs_after(ins.op)) {
                    if ((needs_before(ins.op) and before < 0) or (needs_after(ins.op) and after < 0)) {
                        // Waits for the next character.
                        put(a, &w.list, &w.nlist, pc)
                        break
                    }
                    if (!holds(ins.op, before, after)) {
                        break
                    }
                    pc = pc + 1
                } else {
                    put(a, &w.list, &w.nlist, pc)
                    break
                }
            }
        }
        i = i + 1
    }
}

// The number of the state of w.list with flags, made if it is new;
// FULL if there is no room for it.
fn intern(a: Allocator, inout w: Work, inout d: Dfa, flags: i64, width: i64) i64 {
    var h = flags +% 1469598103934665603
    var i = 0
    while (i < w.nlist) {
        h = (h ^ w.list[i]) *% 1099511628211
        i = i + 1
    }
    if (@len(d.table) == 0) {
        a.resize(&d.table, 64, -1)
    }
    var mask = @len(d.table) - 1
    var slot = h & mask
    while (d.table[slot] >= 0) {
        const id = d.table[slot]
        if (d.meta[4 * id + 3] == h and d.meta[4 * id + 2] == flags and d.meta[4 * id + 1] == w.nlist and same(d, id, w)) {
            return id
        }
        slot = (slot + 1) & mask
    }
    if (@len(d.meta) + @len(d.pcs) + @len(d.trans) + @len(d.table) + width + 4 + w.nlist > d.limit) {
        d.full = true
        return FULL
    }
    const id = d.n
    a.push(&d.meta, @len(d.pcs))
    a.push(&d.meta, w.nlist)
    a.push(&d.meta, flags)
    a.push(&d.meta, h)
    i = 0
    while (i < w.nlist) {
        a.push(&d.pcs, w.list[i])
        i = i + 1
    }
    if ((id + 1) * width > @len(d.trans)) {
        const grown = if (2 * @len(d.trans) > (id + 1) * width) 2 * @len(d.trans) else 8 * width
        a.resize(&d.trans, grown, UNKNOWN)
    }
    d.n = d.n + 1
    d.table[slot] = id
    if (2 * d.n > @len(d.table)) {
        // Twice the table, every state hashed into it again.
        var table = a.alloc(2 * @len(d.table), @as(i64, -1))
        mask = @len(table) - 1
        var j = 0
        while (j < d.n) {
            var at = d.meta[4 * j + 3] & mask
            while (table[at] >= 0) {
                at = (at + 1) & mask
            }
            table[at] = j
            j = j + 1
        }
        const old = @replace(&d.table, table)
        a.free(old)
    }
    return id
}

// Whether state id has the instructions of w.list.
fn same(d: Dfa, id: i64, w: Work) bool {
    const at = d.meta[4 * id]
    var i = 0
    while (i < w.nlist) {
        if (d.pcs[at + i] != w.list[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// The state a search starts at with the side read of kind k.
fn begin(re: rx.Regex, a: Allocator, insts: Buf(prog.Inst), inout w: Work, inout d: Dfa, forward: bool, k: i64, restart: bool, width: i64) i64 {
    if (d.starts[k] != UNKNOWN) {
        return d.starts[k]
    }
    w.nseeds = 0
    put(a, &w.seeds, &w.nseeds, 0)
    close(a, insts, &w, forward, k, -1)
    var id = DEAD
    if (w.nlist > 0 or restart) {
        var flags = k << 1
        if (restart) {
            flags = flags | F_RESTART | F_ONLY
        }
        id = intern(a, &w, &d, flags, width)
        if (id == FULL) {
            return FULL
        }
    }
    d.starts[k] = id
    return id
}

// Where column col takes state st, worked out and kept: a state, DEAD,
// FINISH_MATCH or FINISH_NONE, or FULL. Going forward a match cuts off
// the threads after it, which the pattern likes less; going back, for
// where the match starts, every thread goes on (the longest wins).
fn compute(re: rx.Regex, a: Allocator, insts: Buf(prog.Inst), inout w: Work, inout d: Dfa, forward: bool, st: i64, col: i64, width: i64) i64 {
    const at = d.meta[4 * st]
    const len = d.meta[4 * st + 1]
    const flags = d.meta[4 * st + 2]
    const known = (flags >> 1) & 3
    const restart = (flags & F_RESTART) != 0
    w.nseeds = 0
    var i = 0
    while (i < len) {
        put(a, &w.seeds, &w.nseeds, d.pcs[at + i])
        i = i + 1
    }
    const ncls = @len(re.class_starts)
    if (col >= ncls) {
        close(a, insts, &w, forward, known, col - ncls)
        var r = FINISH_NONE
        i = 0
        while (i < w.nlist) {
            if (insts[w.list[i]].op == .match) {
                r = FINISH_MATCH
            }
            i = i + 1
        }
        d.trans[st * width + col] = r
        return r
    }
    const k = re.class_kinds[col]
    const cp = re.class_starts[col]
    close(a, insts, &w, forward, known, k)
    w.nnext = 0
    var matched = false
    i = 0
    while (i < w.nlist) {
        const pc = w.list[i]
        const ins = insts[pc]
        if (ins.op == .match) {
            matched = true
            if (forward) {
                break
            }
        } else if (accepts(re, ins, cp)) {
            put(a, &w.next, &w.nnext, pc + 1)
        }
        i = i + 1
    }
    const consumed = w.nnext
    const again = restart and !(forward and matched)
    if (again) {
        put(a, &w.next, &w.nnext, 0)
    }
    w.nseeds = 0
    i = 0
    while (i < w.nnext) {
        put(a, &w.seeds, &w.nseeds, w.next[i])
        i = i + 1
    }
    close(a, insts, &w, forward, k, -1)
    var to = DEAD
    if (w.nlist > 0 or again or matched) {
        var f = k << 1
        if (again) {
            f = f | F_RESTART
            if (consumed == 0) {
                f = f | F_ONLY
            }
        }
        if (matched) {
            f = f | F_MATCHED
        }
        to = intern(a, &w, &d, f, width)
        if (to == FULL) {
            return FULL
        }
    }
    d.trans[st * width + col] = to
    return to
}

// Whether the instruction ins takes the code point cp.
fn accepts(re: rx.Regex, ins: prog.Inst, cp: i64) bool {
    switch (ins.op) {
        .char => {
            return cp == ins.x
        }
        .cls => {
            return rx.in_class(re, ins.x, ins.y, cp)
        }
        .any => {
            return cp != 10
        }
        .any_nl => {
            return true
        }
        else => {
            return false
        }
    }
}

// The class of cp.
fn class_of(re: rx.Regex, cp: i64) i64 {
    if (cp < 128) {
        return re.ascii_class[cp]
    }
    var lo = 0
    var hi = @len(re.class_starts)
    while (hi - lo > 1) {
        const mid = lo + (hi - lo) / 2
        if (re.class_starts[mid] <= cp) {
            lo = mid
        } else {
            hi = mid
        }
    }
    return lo
}

// Where the leftmost-first match from start ends, -1 if there is none,
// or FULL. With earliest, the end of any match will do.
fn find_end(re: rx.Regex, a: Allocator, inout w: Work, inout d: Dfa, s: []u8, start: i64, earliest: bool) i64 {
    if (d.full) {
        return FULL
    }
    const ncls = @len(re.class_starts)
    const width = ncls + 4
    var st = begin(re, a, re.insts, &w, &d, true, kind_before(s, start), !re.anchored, width)
    var last = -1
    var pos = start
    while (st >= 0) {
        if (re.skip and (d.meta[4 * st + 2] & F_ONLY) != 0 and pos < @len(s) and !re.first[@as(i64, s[pos])]) {
            // No thread alive: on to where a match could start.
            while (pos < @len(s) and !re.first[@as(i64, s[pos])]) {
                pos = pos + 1
            }
            if (pos >= @len(s)) {
                break
            }
            st = begin(re, a, re.insts, &w, &d, true, kind_before(s, pos), !re.anchored, width)
            continue
        }
        var col = ncls + EDGE
        var step = 0
        if (pos < @len(s)) {
            const r = parse.decode(s, pos)
            col = class_of(re, r.cp)
            step = r.len
        }
        var to = d.trans[st * width + col]
        if (to == UNKNOWN) {
            to = compute(re, a, re.insts, &w, &d, true, st, col, width)
        }
        if (to == FULL) {
            return FULL
        }
        if (step == 0) {
            if (to == FINISH_MATCH) {
                last = pos
            }
            break
        }
        if (to >= 0 and (d.meta[4 * to + 2] & F_MATCHED) != 0) {
            last = pos
            if (earliest) {
                return last
            }
        }
        st = to
        pos = pos + step
    }
    if (st == FULL) {
        return FULL
    }
    return last
}

// Where the match that ends at end starts, as far back as lo: the
// leftmost start, which, end being the leftmost-first match's, is its
// start. -1 if there is none, or FULL.
fn find_start(re: rx.Regex, a: Allocator, inout w: Work, inout d: Dfa, s: []u8, lo: i64, end: i64) i64 {
    if (d.full) {
        return FULL
    }
    const ncls = @len(re.class_starts)
    const width = ncls + 4
    var st = begin(re, a, re.rev, &w, &d, false, kind_after(s, end), false, width)
    var first = -1
    var pos = end
    while (st >= 0) {
        var col = ncls + kind_before(s, lo)
        var step = 0
        if (pos > lo) {
            const r = decode_back(s, lo, pos)
            col = class_of(re, r.cp)
            step = r.len
        }
        var to = d.trans[st * width + col]
        if (to == UNKNOWN) {
            to = compute(re, a, re.rev, &w, &d, false, st, col, width)
        }
        if (to == FULL) {
            return FULL
        }
        if (step == 0) {
            if (to == FINISH_MATCH) {
                first = pos
            }
            break
        }
        if (to >= 0 and (d.meta[4 * to + 2] & F_MATCHED) != 0) {
            first = pos
        }
        st = to
        pos = pos - step
    }
    if (st == FULL) {
        return FULL
    }
    return first
}

// The character that ends at pos, read back no further than lo, cut as
// parse.decode cuts the text going forward: a valid sequence of 2 to 4
// bytes ending there, or else the byte before pos alone.
fn decode_back(s: []u8, lo: i64, pos: i64) parse.Rune {
    const last = @as(i64, s[pos - 1])
    if (last >= 128 and last < 192) {
        var k = 2
        while (k <= 4 and pos - k >= lo) {
            const b = @as(i64, s[pos - k])
            if (b >= 192) {
                const r = parse.decode(s, pos - k)
                if (r.ok and r.len == k) {
                    return r
                }
                break
            }
            if (b < 128) {
                break
            }
            k = k + 1
        }
    }
    if (last < 128) {
        return parse.Rune{ .cp = last, .len = 1, .ok = true }
    }
    return parse.Rune{ .cp = 65533, .len = 1, .ok = false }
}
