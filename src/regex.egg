// regex: regular expressions for Egg, matched in time linear in the
// text, as RE2 and Rust's regex do: no back-references or lookaround,
// so no pattern can make a match take exponential time.
//
// const regex = @import("regex")
// const re = try regex.compile(a, "(\\w+)@(\\w+)\\.com")
// defer a.free(re)
// re.is_match(a, text)             whether it matches anywhere
// re.find(a, text)                 ?regex.Span of the leftmost match
// re.captures(a, text, &caps)      caps[i]: ?regex.Span of group i
// re.next(a, text, &it)            each match in turn, it = regex.iter()
// re.replace_all(a, &out, text, "<$1>")    text with each match replaced
// re.split(a, text, &pieces)       the Spans between the matches
//
// Positions are byte offsets, so text[m.start..m.end] is the match.
// Patterns and text are UTF-8: . and classes match a code point, and a
// byte that is not UTF-8 matches . as U+FFFD would. Matching takes an
// Allocator for the VM's lists, which it frees before returning; a Regex
// is only read, so threads may share one.
uses alloc

const parse = @import("parse.egg")
const prog = @import("prog.egg")

// A match, or a group in one: text[start..end].
const Span = struct {
    start: i64
    end: i64

    fn len(self: Span) i64 {
        return self.end - self.start
    }
}

const Regex = struct {
    insts: Buf(prog.Inst)
    ranges: Buf(parse.Range)
    names: Buf(u8)
    groups: Buf(parse.Group)
    // Groups, counting the whole match as group 0.
    ncap: i64
    // Every match starts at the start of the text (\A or ^ first).
    anchored: bool
    // The pattern is "", which split treats as Go's Split does.
    empty_pattern: bool
    // Every match starts with a byte b where first[b], so a search with
    // no thread alive may skip to the next such byte; false when a match
    // may be empty or start with anything.
    skip: bool
    first: [256]bool

    // Whether the pattern matches anywhere in s.
    fn is_match(self: Regex, a: Allocator, s: []u8) bool {
        var slots: Buf(i64) = .empty
        defer a.free(slots)
        return run(self, a, s, 0, 0, true, &slots)
    }

    // The leftmost match in s, preferring what the pattern prefers (as
    // Perl, RE2 and Rust do: a|ab finds "a" in "ab"), or null.
    fn find(self: Regex, a: Allocator, s: []u8) ?Span {
        return self.find_at(a, s, 0)
    }

    // The leftmost match in s that starts at start or later. ^, \b and
    // the like still see the text before start: "^" does not match at
    // start > 0. A start outside 0..@len(s) finds nothing. For every match
    // in turn, search on from its end, or one character past it when it
    // is empty, and stop once the start is past the end of s.
    fn find_at(self: Regex, a: Allocator, s: []u8, start: i64) ?Span {
        if (start < 0 or start > @len(s)) {
            return null
        }
        var slots: Buf(i64) = .empty
        defer a.free(slots)
        if (!run(self, a, s, start, 2, false, &slots)) {
            return null
        }
        return Span{ .start = slots[0], .end = slots[1] }
    }

    // The leftmost match and its groups: caps gets one ?Span per group,
    // group 0 the whole match, null for a group that took no part.
    // False, and caps empty, if there is no match.
    fn captures(self: Regex, a: Allocator, s: []u8, inout caps: Buf(?Span)) bool {
        return self.captures_at(a, s, 0, &caps)
    }

    // captures from start, which, as for find_at, must be in 0..@len(s).
    fn captures_at(self: Regex, a: Allocator, s: []u8, start: i64, inout caps: Buf(?Span)) bool {
        var slots: Buf(i64) = .empty
        defer a.free(slots)
        if (start < 0 or start > @len(s) or !run(self, a, s, start, 2 * self.ncap, false, &slots)) {
            clear(a, &caps)
            return false
        }
        // a.resize reallocates whenever the length changes, so caps keeps
        // its length from one call to the next and is written in place.
        if (@len(caps) != self.ncap) {
            a.resize(&caps, self.ncap, null)
        }
        var i = 0
        while (i < self.ncap) {
            const lo = slots[2 * i]
            const hi = slots[2 * i + 1]
            caps[i] = if (lo >= 0 and hi >= 0) Span{ .start = lo, .end = hi } else null
            i = i + 1
        }
        return true
    }

    // The next match after the ones it has given, or null when there are
    // no more: as Go's FindAll goes, each search starts at the end of the
    // last match, or a character past it when that was empty, and an
    // empty match right after the last match is skipped (a* on "a" is
    // 0..1 alone).
    fn next(self: Regex, a: Allocator, s: []u8, inout it: Iter) ?Span {
        while (it.pos <= @len(s)) {
            const m = self.find_at(a, s, it.pos) orelse break
            if (step(s, &it, m)) {
                return m
            }
        }
        it.pos = @len(s) + 1
        return null
    }

    // next, with its groups in caps as captures has them; false, caps
    // empty, when there are no more.
    fn next_captures(self: Regex, a: Allocator, s: []u8, inout it: Iter, inout caps: Buf(?Span)) bool {
        while (it.pos <= @len(s)) {
            if (!self.captures_at(a, s, it.pos, &caps)) {
                break
            }
            const m = caps[0] orelse break
            if (step(s, &it, m)) {
                return true
            }
        }
        it.pos = @len(s) + 1
        clear(a, &caps)
        return false
    }

    // Every match, at the end of out.
    fn find_all(self: Regex, a: Allocator, s: []u8, inout out: Buf(Span)) void {
        var it = iter()
        while (self.next(a, s, &it)) |m| {
            a.push(&out, m)
        }
    }

    // s at the end of out, with the first match replaced by template
    // expanded (expand).
    fn replace(self: Regex, a: Allocator, inout out: Buf(u8), s: []u8, template: []u8) void {
        var caps: Buf(?Span) = .empty
        defer a.free(caps)
        if (self.captures(a, s, &caps)) {
            if (caps[0]) |m| {
                a.append_str(&out, s[0..m.start])
                self.expand(a, &out, s, template, caps)
                a.append_str(&out, s[m.end..])
                return
            }
        }
        a.append_str(&out, s)
    }

    // s at the end of out, with every match (as next finds them) replaced
    // by template expanded.
    fn replace_all(self: Regex, a: Allocator, inout out: Buf(u8), s: []u8, template: []u8) void {
        var caps: Buf(?Span) = .empty
        defer a.free(caps)
        var it = iter()
        var last = 0
        while (self.next_captures(a, s, &it, &caps)) {
            const m = caps[0] orelse break
            a.append_str(&out, s[last..m.start])
            self.expand(a, &out, s, template, caps)
            last = m.end
        }
        a.append_str(&out, s[last..])
    }

    // replace_all with the text with as it is, no $ expanded.
    fn replace_all_literal(self: Regex, a: Allocator, inout out: Buf(u8), s: []u8, with: []u8) void {
        var it = iter()
        var last = 0
        while (self.next(a, s, &it)) |m| {
            a.append_str(&out, s[last..m.start])
            a.append_str(&out, with)
            last = m.end
        }
        a.append_str(&out, s[last..])
    }

    // template at the end of out with each $ expanded from caps, the
    // groups of a match in s, as Go's Expand does: $1 or ${1} is group 1,
    // $name or ${name} the group of that name (a name is the longest run
    // of letters, digits and _, so $1x is the group "1x": write ${1}x), $$
    // is a $, and a group that took no part, or that the pattern does not
    // have, is nothing. A $ that starts none of these is itself.
    fn expand(self: Regex, a: Allocator, inout out: Buf(u8), s: []u8, template: []u8, caps: Buf(?Span)) void {
        const n = @len(template)
        var i = 0
        while (i < n) {
            const c = template[i]
            if (c != '$') {
                a.push(&out, c)
                i = i + 1
                continue
            }
            if (i + 1 < n and template[i + 1] == '$') {
                a.push(&out, '$')
                i = i + 2
                continue
            }
            var j = i + 1
            const brace = j < n and template[j] == '{'
            if (brace) {
                j = j + 1
            }
            const start = j
            while (j < n and is_word(template[j])) {
                j = j + 1
            }
            if (j == start or (brace and (j >= n or template[j] != '}'))) {
                a.push(&out, '$')
                i = i + 1
                continue
            }
            const name = template[start..j]
            i = if (brace) j + 1 else j
            const index = group_number(name) orelse (self.group_index(name) orelse -1)
            if (index >= 0 and index < @len(caps)) {
                if (caps[index]) |sp| {
                    a.append_str(&out, s[sp.start..sp.end])
                }
            }
        }
    }

    // The pieces of s between the matches, at the end of out, as Go's
    // Split(s, -1) has them: no empty piece before a match at the very
    // start that is empty, none after the last match if it ends s, and
    // "" for an empty s (nothing at all when the pattern is "" too).
    fn split(self: Regex, a: Allocator, s: []u8, inout out: Buf(Span)) void {
        if (@len(s) == 0) {
            if (!self.empty_pattern) {
                a.push(&out, Span{ .start = 0, .end = 0 })
            }
            return
        }
        var it = iter()
        var begin = 0
        var end = 0
        while (self.next(a, s, &it)) |m| {
            end = m.start
            if (m.end != 0) {
                a.push(&out, Span{ .start = begin, .end = end })
            }
            begin = m.end
        }
        if (end != @len(s)) {
            a.push(&out, Span{ .start = begin, .end = @len(s) })
        }
    }

    // How many groups the pattern has, not counting the whole match.
    fn group_count(self: Regex) i64 {
        return self.ncap - 1
    }

    // The number of the group called name ((?P<name>...) or
    // (?<name>...)), or null.
    fn group_index(self: Regex, name: []u8) ?i64 {
        for (self.groups) |g| {
            if (self.names[g.at..g.at + g.len] == name) {
                return g.index
            }
        }
        return null
    }
}

// The pattern compiled, or an error such as error.MissingParen.
fn compile(a: Allocator, pattern: []u8) !Regex {
    var at = 0
    return compile_where(a, pattern, &at)
}

// compile, leaving at, on an error, at the byte offset of the problem.
fn compile_where(a: Allocator, pattern: []u8, inout at: i64) !Regex {
    var t = try parse.parse(a, pattern, &at)
    const insts = prog.compile(a, t) catch |e| {
        a.free(t)
        return e
    }
    const anchored = prog.anchored(t, t.root)
    var first: [256]bool = @splat(false)
    const skip = prog.firsts(a, insts, t.ranges, &first)
    const re = Regex{ .insts = insts, .ranges = @take(&t.ranges), .names = @take(&t.names), .groups = @take(&t.groups), .ncap = t.ncap, .anchored = anchored, .empty_pattern = @len(pattern) == 0, .skip = skip, .first = first }
    a.free(t)
    return re
}

// Where re.next is in a text: start with iter().
const Iter = struct {
    // Where the next search starts.
    pos: i64
    // Where the last match ended, -1 before the first.
    prev: i64
}

fn iter() Iter {
    return Iter{ .pos = 0, .prev = -1 }
}

// caps emptied, reallocating only if it was not empty already.
fn clear(a: Allocator, inout caps: Buf(?Span)) void {
    if (@len(caps) != 0) {
        a.resize(&caps, 0, null)
    }
}

// Moves it past the match m, found from it.pos; false if m is an empty
// match right after the last one, which next skips.
fn step(s: []u8, inout it: Iter, m: Span) bool {
    var take = true
    if (m.end == it.pos) {
        take = m.start != it.prev
        it.pos = if (it.pos < @len(s)) it.pos + parse.decode(s, it.pos).len else it.pos + 1
    } else {
        it.pos = m.end
    }
    it.prev = m.end
    return take
}

// The group a name of digits only stands for in a template, or null: as
// in Go, not one with a leading 0 ($01), nor one of 9 digits or more.
fn group_number(name: []u8) ?i64 {
    if (@len(name) > 8 or (@len(name) > 1 and name[0] == '0')) {
        return null
    }
    var n = 0
    for (name) |c| {
        if (c < '0' or c > '9') {
            return null
        }
        n = n * 10 + @as(i64, c - '0')
    }
    return n
}

// The VM's memory is one Buf(i64), so that a call allocates once (malloc
// was most of the time of a short match). Two lists of threads, each at
// a base b: dense[b..b + n] the instructions of its threads in priority
// order, sparse[b + n + pc] where pc is in dense (if it is), and the k
// slots of thread i at b + 2n + i * k. Then k slots being filled, and a
// stack of jobs for add, 3 words each: an instruction to go on at, or a
// slot (>= 0) and the value a save took from it, to put back.

// The most bits backtrack's visited set may have, as in Go: past it the
// Pike VM, whose memory does not grow with the text, runs instead.
const MAX_BACKTRACK = 262144

// Runs the program on s from start: k slots (2 per group) are wanted,
// and on a match m[0..k] holds them, -1 for a group that took no part.
// With earliest, any match will do. m may hold anything when it comes,
// from an earlier call. Short texts go to backtrack, longer ones to
// pike; both find the same match.
fn run(re: Regex, a: Allocator, s: []u8, start: i64, k: i64, earliest: bool, inout m: Buf(i64)) bool {
    if (@len(re.insts) * (@len(s) - start + 1) <= MAX_BACKTRACK) {
        return backtrack(re, a, s, start, k, &m)
    }
    return pike(re, a, s, start, k, earliest, &m)
}

// The match a depth-first search finds, trying a split's first branch
// first and each start in turn: the leftmost-first one, as pike finds it.
// Each state (instruction, position) is tried at most once, from every
// start alike (one that failed fails again), so the time is still
// O(len(s) * len(insts)), but with no list of threads to keep: for short
// texts, where the set of states is small, this is the faster.
fn backtrack(re: Regex, a: Allocator, s: []u8, start: i64, k: i64, inout m: Buf(i64)) bool {
    const n = @len(re.insts)
    const len = @len(s) - start + 1
    // m: k slots, the visited bits ((pos - start) * n + pc), then a stack
    // of jobs, 3 words each: go on at pc and pos, or (slot >= 0) put a
    // slot back as it was before a save. The stack grows when it must,
    // by doubling, so that a call allocates once or nearly.
    const words = (n * len + 63) / 64
    const base = k + words
    a.resize(&m, base + 6 * (n + 1), 0)
    // m may come with something in it: every bit starts clear.
    var j = 0
    while (j < base) {
        m[j] = if (j < k) -1 else 0
        j = j + 1
    }
    var top = base
    var p = start
    while (p <= @len(s)) {
        if (re.skip) {
            while (p < @len(s) and !re.first[@as(i64, s[p])]) {
                p = p + 1
            }
            if (p >= @len(s)) {
                return false
            }
        }
        m[top] = 0
        m[top + 1] = p
        m[top + 2] = -1
        top = top + 3
        while (top > base) {
            top = top - 3
            var pc = m[top]
            var pos = m[top + 1]
            const slot = m[top + 2]
            if (slot >= 0) {
                m[slot] = pos
                continue
            }
            while (true) {
                const bit = (pos - start) * n + pc
                const word = k + bit / 64
                const mask = @as(i64, 1) << (bit % 64)
                if ((m[word] & mask) != 0) {
                    break
                }
                m[word] = m[word] | mask
                const ins = re.insts[pc]
                var go = false
                switch (ins.op) {
                    .char, .cls, .any, .any_nl => {
                        if (pos < @len(s)) {
                            const r = parse.decode(s, pos)
                            if (ins.op == .char) {
                                go = r.cp == ins.x
                            } else if (ins.op == .cls) {
                                go = in_class(re, ins.x, ins.y, r.cp)
                            } else {
                                go = ins.op == .any_nl or r.cp != 10
                            }
                            if (go) {
                                pos = pos + r.len
                            }
                        }
                    }
                    .match => {
                        return true
                    }
                    .jmp => {
                        pc = ins.x - 1
                        go = true
                    }
                    .split => {
                        if (top + 3 > @len(m)) {
                            const grown = 2 * @len(m)
                            a.resize(&m, grown, 0)
                        }
                        m[top] = ins.y
                        m[top + 1] = pos
                        m[top + 2] = -1
                        top = top + 3
                        pc = ins.x - 1
                        go = true
                    }
                    .save => {
                        if (ins.x < k) {
                            if (top + 3 > @len(m)) {
                                const grown = 2 * @len(m)
                            a.resize(&m, grown, 0)
                            }
                            m[top] = 0
                            m[top + 1] = m[ins.x]
                            m[top + 2] = ins.x
                            top = top + 3
                            m[ins.x] = pos
                        }
                        go = true
                    }
                    else => {
                        go = holds(s, ins.op, pos)
                    }
                }
                if (!go) {
                    break
                }
                pc = pc + 1
            }
        }
        if (re.anchored) {
            return false
        }
        p = if (p < @len(s)) p + parse.decode(s, p).len else p + 1
    }
    return false
}

// Whether the assertion op holds at pos in s.
fn holds(s: []u8, op: prog.Op, pos: i64) bool {
    switch (op) {
        .begin_line => {
            return pos == 0 or s[pos - 1] == '\n'
        }
        .end_line => {
            return pos == @len(s) or s[pos] == '\n'
        }
        .begin_text => {
            return pos == 0
        }
        .end_text => {
            return pos == @len(s)
        }
        .word, .not_word => {
            const before = pos > 0 and is_word(s[pos - 1])
            const after = pos < @len(s) and is_word(s[pos])
            return (before != after) == (op == .word)
        }
        else => {
            return false
        }
    }
}

// Runs the program on s from start, Pike's way: all threads step over a
// character together, so the time is O(len(s) * len(insts)) and the
// memory O(len(insts)). As run, which calls it for longer texts.
fn pike(re: Regex, a: Allocator, s: []u8, start: i64, k: i64, earliest: bool, inout m: Buf(i64)) bool {
    const n = @len(re.insts)
    const size = 2 * n + n * k
    const tmp = 2 * size
    const best = tmp + k
    const stack = best + k
    a.resize(&m, stack + 3 * n + 3, 0)
    var cur = 0
    var ncur = 0
    var nxt = size
    var nnxt = 0
    var j = 0
    while (j < k) {
        m[best + j] = -1
        j = j + 1
    }
    var matched = false
    var pos = start
    while (true) {
        if (!matched and ncur == 0 and re.skip) {
            // No thread is alive: on to where a match could start.
            while (pos < @len(s) and !re.first[@as(i64, s[pos])]) {
                pos = pos + 1
            }
            if (pos >= @len(s)) {
                break
            }
        }
        if (!matched and (!re.anchored or pos == 0)) {
            j = 0
            while (j < k) {
                m[tmp + j] = -1
                j = j + 1
            }
            add(re, s, &m, cur, &ncur, k, tmp, stack, 0, pos)
        }
        if (ncur == 0 and (matched or (re.anchored and pos > 0))) {
            break
        }
        var r = parse.Rune{ .cp = -1, .len = 1, .ok = false }
        if (pos < @len(s)) {
            r = parse.decode(s, pos)
        }
        var i = 0
        while (i < ncur) {
            const pc = m[cur + i]
            const ins = re.insts[pc]
            var takes = false
            switch (ins.op) {
                .match => {
                    if (earliest) {
                        return true
                    }
                    j = 0
                    while (j < k) {
                        m[best + j] = m[cur + 2 * n + i * k + j]
                        j = j + 1
                    }
                    matched = true
                    // Threads after this one have a lower priority.
                    break
                }
                .char => {
                    takes = r.cp == ins.x
                }
                .cls => {
                    takes = r.cp >= 0 and in_class(re, ins.x, ins.y, r.cp)
                }
                .any => {
                    takes = r.cp >= 0 and r.cp != 10
                }
                .any_nl => {
                    takes = r.cp >= 0
                }
                else => {}
            }
            if (takes) {
                j = 0
                while (j < k) {
                    m[tmp + j] = m[cur + 2 * n + i * k + j]
                    j = j + 1
                }
                add(re, s, &m, nxt, &nnxt, k, tmp, stack, pc + 1, pos + r.len)
            }
            i = i + 1
        }
        if (pos >= @len(s)) {
            break
        }
        pos = pos + r.len
        const was = cur
        cur = nxt
        nxt = was
        ncur = nnxt
        nnxt = 0
    }
    j = 0
    while (j < k) {
        m[j] = m[best + j]
        j = j + 1
    }
    return matched
}

// Adds the thread at start, with the slots at m[tmp..tmp + k], to the
// list at base b holding count threads, following jumps, splits (the
// first branch first), saves and assertions at pos to the instructions
// that consume a character or match.
fn add(re: Regex, s: []u8, inout m: Buf(i64), b: i64, inout count: i64, k: i64, tmp: i64, stack: i64, start: i64, pos: i64) void {
    const n = @len(re.insts)
    var top = stack
    m[top] = start
    m[top + 1] = -1
    top = top + 3
    while (top > stack) {
        top = top - 3
        if (m[top + 1] >= 0) {
            m[tmp + m[top + 1]] = m[top + 2]
            continue
        }
        var pc = m[top]
        while (true) {
            // sparse may hold anything where pc was never added.
            const at = m[b + n + pc]
            if (at >= 0 and at < count and m[b + at] == pc) {
                break
            }
            m[b + n + pc] = count
            m[b + count] = pc
            const i = count
            count = count + 1
            const ins = re.insts[pc]
            var next = -1
            switch (ins.op) {
                .jmp => {
                    next = ins.x
                }
                .split => {
                    m[top] = ins.y
                    m[top + 1] = -1
                    top = top + 3
                    next = ins.x
                }
                .save => {
                    if (ins.x < k) {
                        m[top + 1] = ins.x
                        m[top + 2] = m[tmp + ins.x]
                        top = top + 3
                        m[tmp + ins.x] = pos
                    }
                    next = pc + 1
                }
                .begin_line, .end_line, .begin_text, .end_text, .word, .not_word => {
                    if (holds(s, ins.op, pos)) {
                        next = pc + 1
                    }
                }
                else => {
                    // Consumes or matches: it keeps the slots as they are.
                    var j = 0
                    while (j < k) {
                        m[b + 2 * n + i * k + j] = m[tmp + j]
                        j = j + 1
                    }
                }
            }
            if (next < 0) {
                break
            }
            pc = next
        }
    }
}

fn is_word(c: u8) bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
}

// Whether cp is in the sorted ranges re.ranges[at..at + n].
fn in_class(re: Regex, at: i64, n: i64, cp: i64) bool {
    var lo = at
    var hi = at + n
    while (lo < hi) {
        const mid = lo + (hi - lo) / 2
        const r = re.ranges[mid]
        if (cp < r.lo) {
            hi = mid
        } else if (cp > r.hi) {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}
